---
type FaqItem = [string, string];
type FaqGroup = [string, FaqItem[]];

interface Props {
  heading?: string;
  items?: FaqItem[];
  groups?: FaqGroup[];
  headingId?: string;
  className?: string;
}

const {
  heading,
  items = [],
  groups = [],
  headingId = "faq-section-title",
  className = ""
} = Astro.props;

const sectionClass = ["faq-section", groups.length > 0 ? "faq-section--grouped" : "", className].filter(Boolean).join(" ");
---

<section class={sectionClass} aria-labelledby={heading ? headingId : undefined}>
  {heading && <h2 id={headingId}>{heading}</h2>}
  {groups.length > 0 ? groups.map(([groupHeading, groupItems]) => <section class="faq-group">
    <h2>{groupHeading}</h2>
    <div class="faq-grid">
      {groupItems.map(([question, answer]) => <article class="faq-item"><h3>{question}</h3><p>{answer}</p></article>)}
    </div>
  </section>) : <div class="faq-grid">
    {items.map(([question, answer]) => <article class="faq-item"><h3>{question}</h3><p>{answer}</p></article>)}
  </div>}
</section>
