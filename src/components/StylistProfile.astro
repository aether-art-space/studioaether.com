---
import { InstagramLogoIcon } from "@phosphor-icons/react/ssr";
import ResponsiveImage from "./ResponsiveImage.astro";
import GalleryImage from "./GalleryImage.astro";

interface ArtistImage {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

interface ArtistProfile {
  name: string;
  role: string;
  specialties: string;
  image: ArtistImage;
  gallery?: ArtistImage[];
  socials?: Array<{ type: string; label: string; href: string }>;
}

interface Props {
  profile: ArtistProfile;
  email: string;
  hu: boolean;
}

const { profile, email, hu } = Astro.props;
const gallery = profile.gallery ?? [];
const socials = profile.socials ?? [];
---

<div class="stylist-profile-wrap">
  <article class="stylist-profile" aria-labelledby="stylist-profile-name">
    <div class="stylist-profile__identity">
      <div class="stylist-profile__portrait-wrap">
        <ResponsiveImage image={{ ...profile.image, width: 200, height: 200 }} role="card" className="stylist-profile__portrait" loading="lazy" />
        {socials.map((social) => social.type === "instagram" && <a class="stylist-profile__social" href={social.href} target="_blank" rel="noreferrer noopener" aria-label={social.label}>
          <InstagramLogoIcon size={25} weight="regular" aria-hidden="true" />
        </a>)}
      </div>
      <h2 id="stylist-profile-name">{profile.name}</h2>
      <p class="stylist-profile__role">{profile.role}</p>
      <p class="stylist-profile__specialties">{profile.specialties}</p>
    </div>
    {gallery.length > 0 && <div class="stylist-profile__gallery" aria-label={hu ? `${profile.name} galériája` : `${profile.name}'s gallery`}>
    {gallery.map((image) => <GalleryImage image={image} className="stylist-profile__gallery-item" label={hu ? "Kép megnyitása" : "Open image"} title={profile.name} description={profile.specialties} link={`mailto:${email}`} linkLabel={email} />)}
  </div>}
</article>
</div>
