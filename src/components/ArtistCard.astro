---
import { InstagramLogoIcon, XLogoIcon } from "@phosphor-icons/react/ssr";
import ResponsiveImage from "./ResponsiveImage.astro";
import GalleryImage from "./GalleryImage.astro";

interface ArtistImage {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
}

interface ArtistSocial {
  type: "instagram" | "x";
  label: string;
  href: string;
}

interface ArtistProfile {
  name: string;
  role: string;
  specialties: string;
  description?: string;
  price?: string;
  image: ArtistImage;
  gallery?: ArtistImage[];
  website?: string;
  websiteUrl?: string;
  socials?: ArtistSocial[];
  more?: string;
  moreHref?: string;
}

interface Props {
  profile: ArtistProfile;
  hu: boolean;
  de?: boolean;
  showGalleryProfileMeta?: boolean;
}

const { profile, hu, de = false, showGalleryProfileMeta = true } = Astro.props;
const isExternalMoreLink = profile.moreHref?.startsWith("http");
const socials = profile.socials ?? [];
const gallery = profile.gallery ?? [];
---

<article class="artist-profile" data-gallery>
  <div class="artist-profile__image">
    <ResponsiveImage image={profile.image} role="card" loading="lazy" />
    <div class="artist-profile__image-copy">
      <h3 class="artist-profile__image-name">{profile.name}</h3>
      <p class="artist-profile__image-role"><strong>{profile.role}</strong></p>
    </div>
    {socials.length > 0 && <div class="artist-profile__socials" aria-label={hu ? `${profile.name} közösségi profiljai` : `${profile.name}'s social profiles`}>
      {socials.map((social) => <a class="artist-profile__social" href={social.href} target="_blank" rel="noreferrer noopener" aria-label={hu ? `${profile.name} a ${social.label} felületén` : `${profile.name} on ${social.label}`}>
        {social.type === "instagram" ? <InstagramLogoIcon size={32} weight="regular" aria-hidden="true" /> : <XLogoIcon size={32} weight="regular" aria-hidden="true" />}
      </a>)}
    </div>}
  </div>
  <div class="artist-profile__body">
    <div class="artist-profile__specialties" aria-label={hu ? "Szakterületek" : "Specialties"}>
    {profile.specialties.split(", ").map((specialty) => <span>{specialty}</span>)}
    </div>
    {profile.description && <p class="artist-profile__description">{profile.description}</p>}
    {profile.price && <strong>{profile.price}</strong>}
    <div class="artist-profile__links">
      {profile.websiteUrl ? <a class="artist-profile__website text-link" href={profile.websiteUrl} target="_blank" rel="noreferrer noopener">{profile.website}</a> : <span class="artist-profile__website-placeholder" aria-hidden="true">-</span>}
    </div>
    {profile.more && profile.moreHref && <a class="artist-profile__more button button--secondary" href={profile.moreHref} target={isExternalMoreLink ? "_blank" : undefined} rel={isExternalMoreLink ? "noreferrer noopener" : undefined}>{profile.more}</a>}
  </div>
  {gallery.length > 0 && <div class="artist-profile__gallery">
    {gallery.map((image) => <GalleryImage image={image} className="artist-profile__gallery-item" label={de ? "Bild öffnen" : hu ? "Kép megnyitása" : "Open image"} title={showGalleryProfileMeta ? profile.name : undefined} description={showGalleryProfileMeta ? profile.description : undefined} link={showGalleryProfileMeta ? profile.websiteUrl : undefined} linkLabel={showGalleryProfileMeta ? profile.website : undefined} suppressProfileMeta={!showGalleryProfileMeta} />)}
  </div>}
</article>
