---
import PriceCard from "./PriceCard.astro";

interface PriceItem {
  title: string;
  titleLines?: string[];
  titleAccent?: string;
  description?: string;
  descriptionLines?: Array<{ text: string; bold?: boolean }>;
  price: string;
  features?: string[];
}

interface PriceCardCta {
  label: string;
  href?: string;
  event?: string;
  location?: string;
  contact?: boolean;
}

interface Props {
  id?: string;
  heading?: string;
  packages: PriceItem[];
  lead?: string;
  note?: string;
  includesLabel?: string;
  headingId?: string;
  ariaLabel?: string;
  className?: string;
  gridClassName?: string;
  cta?: PriceCardCta;
}

const {
  id,
  heading,
  packages,
  lead,
  note,
  includesLabel,
  headingId = "price-section-title",
  ariaLabel = "Pricing",
  className = "",
  gridClassName = "",
  cta
} = Astro.props;

const sectionClass = ["service-section", "service-section--packages", "price-section", packages.length > 3 ? "price-section--wide" : "", className].filter(Boolean).join(" ");
const gridClass = ["service-package-grid", gridClassName].filter(Boolean).join(" ");
---

<section id={id} class={sectionClass} aria-labelledby={heading ? headingId : undefined} aria-label={!heading ? ariaLabel : undefined} data-reveal-section>
  {note && <p class="service-note" data-reveal-item>{note}</p>}
  {heading && <h2 id={headingId} data-reveal-item>{heading}</h2>}
  {lead && <p data-reveal-item>{lead}</p>}
  <slot name="tabs" />
  <div class={gridClass}>
    {packages.map((packageItem) => <PriceCard title={packageItem.title} titleLines={packageItem.titleLines} titleAccent={packageItem.titleAccent} description={packageItem.description} descriptionLines={packageItem.descriptionLines} price={packageItem.price} includesLabel={includesLabel} features={packageItem.features} cta={cta} />)}
  </div>
</section>
