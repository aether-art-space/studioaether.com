---
import PriceCard from "./PriceCard.astro";

interface PriceItem {
  title: string;
  titleLines?: string[];
  titleAccent?: string;
  description?: string;
  descriptionLines?: Array<{ text: string; bold?: boolean }>;
  price: string;
  features?: string[];
}

interface Props {
  id?: string;
  heading?: string;
  packages: PriceItem[];
  lead?: string;
  note?: string;
  includesLabel?: string;
  headingId?: string;
  ariaLabel?: string;
  className?: string;
  gridClassName?: string;
}

const {
  id,
  heading,
  packages,
  lead,
  note,
  includesLabel,
  headingId = "price-section-title",
  ariaLabel = "Pricing",
  className = "",
  gridClassName = ""
} = Astro.props;

const sectionClass = ["service-section", "service-section--packages", "price-section", packages.length > 3 ? "price-section--wide" : "", className].filter(Boolean).join(" ");
const gridClass = ["service-package-grid", gridClassName].filter(Boolean).join(" ");
---

<section id={id} class={sectionClass} aria-labelledby={heading ? headingId : undefined} aria-label={!heading ? ariaLabel : undefined}>
  {note && <p class="service-note">{note}</p>}
  {heading && <h2 id={headingId}>{heading}</h2>}
  {lead && <p>{lead}</p>}
  <slot name="tabs" />
  <div class={gridClass}>
    {packages.map((packageItem) => <PriceCard title={packageItem.title} titleLines={packageItem.titleLines} titleAccent={packageItem.titleAccent} description={packageItem.description} descriptionLines={packageItem.descriptionLines} price={packageItem.price} includesLabel={includesLabel} features={packageItem.features} />)}
  </div>
</section>
