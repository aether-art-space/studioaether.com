---
import { site, localizedPath, localizedNav, sitePath } from "../lib/site.mjs";
import AetherHeaderNavigation from "./AetherHeaderNavigation";
import ResponsiveImage from "./ResponsiveImage.astro";
const { page } = Astro.props;
const hu = page.language === "hu";
const languageHref = page.counterpartPath || (hu ? "/" : "/hu");
const groups = localizedNav(page.language);
const navigationGroups = groups.map((group) => ({
  label: group.label,
  links: group.links.map(([href, label]) => ({ href, label }))
}));
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={hu ? "/hu" : "/"} aria-label={site.name}>
      <ResponsiveImage image={{ src: "/images/wix/jpg/logo-full.jpg", alt: site.name, width: 326, height: 184 }} role="logo" loading="eager" />
    </a>
    <AetherHeaderNavigation
      client:load
      bookingHref={localizedPath("/booking", page.language)}
      bookingExternalHref={site.bookingUrl}
      homeHref={sitePath(hu ? "/hu" : "/")}
      bookingLabel={hu ? "árak és foglalás" : "prices & booking"}
      groups={navigationGroups}
      languageHref={languageHref}
      languageLabel={hu ? "HU" : "EN"}
      languageMenuLabel={hu ? "Oldal és nyelv" : "Page and language"}
      mentoringHref={localizedPath("/photographer-mentoring-budapest", page.language)}
      mentoringLabel={hu ? "mentorálás" : "mentoring"}
      navigationLabel={hu ? "Fő navigáció" : "Primary navigation"}
    />
  </div>
</header>
