---
interface Props {
  title: string;
  titleLines?: string[];
  titleAccent?: string;
  description?: string;
  descriptionLines?: Array<{ text: string; bold?: boolean }>;
  price: string;
  features?: string[];
  featureBreaks?: number[];
  includesLabel?: string;
  className?: string;
  cta?: {
    label: string;
    href?: string;
    event?: string;
    location?: string;
    contact?: boolean;
  };
}

const {
  title,
  titleLines = [],
  titleAccent = "",
  description = "",
  descriptionLines = [],
  price,
  features = [],
  featureBreaks = [],
  includesLabel,
  className = "",
  cta
} = Astro.props;

const isSimpleCard = !description && descriptionLines.length === 0 && !includesLabel && features.length === 0;
---

<article class={`price-card ${isSimpleCard ? "price-card--simple" : ""} ${className}`.trim()} data-reveal-item>
  <header class="price-card__header">
    <h3>
      {titleLines.length > 0 ? titleLines.map((line, index) => <span>{line}{index < titleLines.length - 1 && <br />}</span>) : title}
      {titleAccent && <><br /><span class="price-card__accent">{titleAccent}</span></>}
    </h3>
    {descriptionLines.length > 0
      ? <div class="price-card__description price-card__description--lines">{descriptionLines.map((line) => <p class={line.bold ? "price-card__description-line--bold" : ""}>{line.text || "\u00a0"}</p>)}</div>
      : description && <p class="price-card__description">{description}</p>}
  </header>
  <div class="price-card__details">
    <p class="price-card__price"><strong>{price}</strong></p>
  </div>
  {(includesLabel || features.length > 0 || cta) && <div class="price-card__features">
    {includesLabel && <p class="price-card__includes">{includesLabel}</p>}
    {features.length > 0 && <ul aria-label={includesLabel ?? "Package features"}>
      {features.map((feature, index) => <li class={featureBreaks.includes(index) ? "price-card__feature-break" : undefined}>{feature}</li>)}
    </ul>}
    {cta?.href
      ? <a class="price-card__action" data-gtag-event={cta.event} data-gtag-location={cta.location} href={cta.href}>{cta.label}</a>
      : cta?.contact && <button class="price-card__action" data-gtag-event={cta.event} data-gtag-location={cta.location} type="button" data-site-contact-open aria-controls="site-contact-modal">{cta.label}</button>}
  </div>}
</article>
