---
interface Props {
  title: string;
  eyebrow?: string;
  titleLines?: string[];
  titleAccent?: string;
  description?: string;
  descriptionLines?: Array<{ text: string; bold?: boolean }>;
  price: string;
  features?: string[];
  featureBreaks?: number[];
  highlightedFeatures?: number[];
  includesLabel?: string;
  className?: string;
  descriptionAbovePrice?: boolean;
  cta?: {
    label: string;
    href?: string;
    event?: string;
    location?: string;
    contact?: boolean;
  };
}

const {
  title,
  eyebrow = "",
  titleLines = [],
  titleAccent = "",
  description = "",
  descriptionLines = [],
  price,
  features = [],
  featureBreaks = [],
  highlightedFeatures = [],
  includesLabel,
  className = "",
  descriptionAbovePrice = false,
  cta
} = Astro.props;

const isSimpleCard = !description && descriptionLines.length === 0 && !includesLabel && features.length === 0;
const hasCta = Boolean(cta?.href || cta?.contact);
---

<article class={`price-card ${isSimpleCard ? "price-card--simple" : ""} ${className}`.trim()} data-reveal-item>
  <header class="price-card__header">
    {eyebrow && <p class="price-card__eyebrow">{eyebrow}</p>}
    <h3>
      {titleLines.length > 0 ? titleLines.map((line, index) => <span>{line}{index < titleLines.length - 1 && <br />}</span>) : title}
      {titleAccent && <><br /><span class="price-card__accent">{titleAccent}</span></>}
    </h3>
    {!descriptionAbovePrice && (descriptionLines.length > 0
      ? <div class="price-card__description price-card__description--lines">{descriptionLines.map((line) => <p class={line.bold ? "price-card__description-line--bold" : ""}>{line.text || "\u00a0"}</p>)}</div>
      : description && <p class="price-card__description">{description}</p>)}
  </header>
  <div class="price-card__details">
    {descriptionAbovePrice && description && <p class="price-card__price-label">{description}</p>}
    <p class="price-card__price"><strong>{price}</strong></p>
    {!includesLabel && features.length === 0 && hasCta && <div class="price-card__action-wrap">
      {cta?.href
        ? <a class="price-card__action" data-gtag-event={cta.event} data-gtag-location={cta.location} href={cta.href}>{cta.label}</a>
        : cta?.contact && <button class="price-card__action" data-gtag-event={cta.event} data-gtag-location={cta.location} type="button" data-site-contact-open aria-controls="site-contact-modal">{cta.label}</button>}
    </div>}
  </div>
  {(includesLabel || features.length > 0) && <div class="price-card__features">
    {includesLabel && <p class="price-card__includes">{includesLabel}</p>}
    {features.length > 0 && (featureBreaks.length === 1 ? <div class="price-card__feature-groups">
      <ul class="price-card__coverage-features" aria-label={includesLabel ?? "Package features"}>{features.slice(0, featureBreaks[0]).map((feature, index) => <li>{highlightedFeatures.includes(index) ? <strong>{feature}</strong> : feature}</li>)}</ul>
      <ul class="price-card__practical-features" aria-label="Package details">{features.slice(featureBreaks[0]).map((feature, index) => <li>{highlightedFeatures.includes(index + featureBreaks[0]) ? <strong>{feature}</strong> : feature}</li>)}</ul>
    </div> : <ul aria-label={includesLabel ?? "Package features"}>
      {features.map((feature, index) => <li class={featureBreaks.includes(index) ? "price-card__feature-break" : undefined}>{highlightedFeatures.includes(index) ? <strong>{feature}</strong> : feature}</li>)}
    </ul>)}
    {hasCta && <div class="price-card__action-wrap">
      {cta?.href
        ? <a class="price-card__action" data-gtag-event={cta.event} data-gtag-location={cta.location} href={cta.href}>{cta.label}</a>
        : cta?.contact && <button class="price-card__action" data-gtag-event={cta.event} data-gtag-location={cta.location} type="button" data-site-contact-open aria-controls="site-contact-modal">{cta.label}</button>}
    </div>}
  </div>}
</article>
