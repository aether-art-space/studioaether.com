---
import ResponsiveImage from "./ResponsiveImage.astro";

interface CardImage {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

interface Props {
  title: string;
  description?: string;
  priceLabel?: string;
  price?: string;
  href?: string;
  linkLabel?: string;
  showLink?: boolean;
  image?: CardImage;
  className?: string;
}

const {
  title,
  description = "",
  priceLabel = "",
  price = "",
  href,
  linkLabel = "learn more",
  showLink = false,
  image,
  className = ""
} = Astro.props;

const cardClass = ["extras-card", image ? "extras-card--image" : "", className].filter(Boolean).join(" ");
---

<article class={cardClass} data-reveal-item>
  {image && <ResponsiveImage image={image} role="card" className="extras-card__image" loading="lazy" />}
  {image ? <div class="extras-card__body">
    <h4>{title}</h4>
    {description && <p class="extras-card__description">{description}</p>}
    {(priceLabel || price) && <div class="extras-card__price">
      {priceLabel && <span>{priceLabel}</span>}
      {price && <strong>{price}</strong>}
    </div>}
    {showLink && href && <a class="text-link" href={href}>{linkLabel}</a>}
  </div> : <>
    <h4>{title}</h4>
    {description && <p class="extras-card__description">{description}</p>}
    {(priceLabel || price) && <div class="extras-card__price">
      {priceLabel && <span>{priceLabel}</span>}
      {price && <strong>{price}</strong>}
    </div>}
    {showLink && href && <a class="text-link" href={href}>{linkLabel}</a>}
  </>}
</article>
