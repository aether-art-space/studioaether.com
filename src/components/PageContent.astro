    <InfoBox class="booking-extras-note"><p>{de ? "Alle weiteren Möbel, Requisiten und tragbaren Kleidungsstücke im Studio kannst du kostenlos nutzen." : hu ? "Minden egyéb bútor, kellék vagy viselhető tárgy ingyenesen használható a stúdiónkban." : "All other furniture, props, and wearable items in the studio are free to use."}</p></InfoBox>
  </>
) : page.section === "faq" ? (
  <>
    <PageHero variant="service" headingId="faq-title" title={page.h1} subtitle={introFor(page)} />
    <FaqSection groups={faqGroups} continuous className="faq-section--standalone" />
  </>
) : page.section === "legal" ? (
  <>
    <PageHero variant="service" headingId="legal-title" title={page.h1} eyebrow={de ? "Datenschutzinformationen" : hu ? "jogi információ" : "legal information"} description={legalPage.intro}>
      <p class="page-hero__meta">{legalPage.lastUpdated}</p>
    </PageHero>
    <section class="legal-copy">{legalPage.sections.map((section: any) => <section><h2>{section[0]}</h2>{section[1].map((paragraph: string) => <p>{paragraph}</p>)}</section>)}</section>
  </>
) : page.path.endsWith("photographer-daniel") ? (
  <>
    <PageHero variant="service" headingId="profile-title" title={page.h1} eyebrow={de ? "Fotografenprofil" : hu ? "fotós profil" : "photographer profile"} lead={de ? "Dániel Z. Aczél ist Fotograf und Gründer von aether art space in Budapest." : hu ? "Dániel Z. Aczél fotós és az aether art space alapítója Budapesten." : "Dániel Z. Aczél is a photographer and the founder of aether art space in Budapest."}>
      <div class="page-hero__actions"><a class="button" href={`mailto:${site.email}`}>{de ? "Studio kontaktieren" : hu ? "kapcsolat" : "contact the studio"}</a><a class="text-link" href={localizedPath("/photographers-budapest", language)}>{de ? "Fotografen im Studio" : hu ? "rezidens fotósok" : "resident photographers"}</a></div>
    </PageHero>
    <section class="split-copy"><div><h2>{hu ? "Fotózás, tanítás és közös stúdió" : "Photography, teaching and a shared studio"}</h2><p>{hu ? "Ezt a sitemapból is elérhető profilt a migráció alatt megőrizzük." : "This sitemap-discovered profile is preserved during migration."}</p></div><div class="audit-note">{page.action}</div></section>
  </>
) : (
  <>
    <section class="hero"><p class="eyebrow">{de ? localizedServiceType : page.purpose}</p><h1>{page.h1}</h1><p class="hero-lead">{introFor(page)}</p><div class="actions"><a class="button" data-gtag-event="booking_click" data-gtag-location="service" href={localizedPath("/booking", language)}>{de ? "Verfügbarkeit prüfen" : hu ? "érdekel a foglalás" : "check availability"}</a><a class="text-link" href={relatedHref}>{de ? "Fotoshooting-Pakete ansehen" : hu ? "csomagok megtekintése" : "view photography packages"}</a></div></section>
    <section class="split-copy"><div class="visual-card"><span>budapest</span><strong>aether<br />art space</strong></div><div><p class="eyebrow">{de ? "für deinen kreativen Prozess" : hu ? "a lehetőségek" : "made for the process"}</p><h2>{page.h1}</h2><p>{de ? `Unser Angebot rund um ${page.purpose.toLowerCase()} basiert auf einer ruhigen, flexiblen Studioatmosphäre mit dem Raum und der Aufmerksamkeit, die dein Projekt braucht.` : hu ? `Az ${page.purpose.toLowerCase()} szolgáltatást a budapesti aether art space-ben úgy alakítottuk ki, hogy az alkotáshoz szükséges tér és figyelem egy helyen legyen.` : `Our ${page.purpose.toLowerCase()} offering is built around a calm, flexible studio environment with the space and attention your project needs.`}</p><p>{de ? "Schreib uns für Details, Verfügbarkeit und eine persönliche Empfehlung." : hu ? "A pontos részletekért, elérhetőségért és személyre szabott ajánlatért írj nekünk." : "Contact us for details, availability and a tailored recommendation."}</p><a class="text-link" href={`mailto:${site.email}`}>{de ? "Nachricht schreiben" : hu ? "írj nekünk" : "send us a message"}</a></div></section>
    <section class="related"><p class="eyebrow">{de ? "passende Seiten" : hu ? "kapcsolódó oldalak" : "continue exploring"}</p><div class="related-links">{serviceLinks.map(([path, label]) => <a class="text-link" href={path}>{label}</a>)}</div></section>
  </>
)}

<script>
  const lightbox = document.querySelector<HTMLDialogElement>("[data-studio-lightbox]");
  const image = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const lightboxAvif = lightbox?.querySelector<HTMLSourceElement>("[data-lightbox-avif]");
  const lightboxWebp = lightbox?.querySelector<HTMLSourceElement>("[data-lightbox-webp]");
  const title = lightbox?.querySelector<HTMLElement>("[data-lightbox-title]");
  const description = lightbox?.querySelector<HTMLElement>("[data-lightbox-description]");
  const price = lightbox?.querySelector<HTMLElement>("[data-lightbox-price]");
    const linkSlot = lightbox?.querySelector<HTMLElement>("[data-lightbox-link-slot]");
  const counter = lightbox?.querySelector<HTMLElement>("[data-lightbox-counter]");
  const previous = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-previous]");
  const next = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-next]");
  let galleryItems: HTMLElement[] = [];
  let activeIndex = 0;
  let lastTrigger: HTMLElement | null = null;

  const galleryFor = (item: HTMLElement) =>
    item.closest<HTMLElement>("[data-gallery]") ||
    item.closest<HTMLElement>("[data-horizontal-gallery]") ||
    item.closest<HTMLElement>("[class*='gallery']");
  const itemsFor = (item: HTMLElement) => {
    const gallery = galleryFor(item);
    const items = gallery ? [...gallery.querySelectorAll<HTMLElement>("[data-gallery-image]")] : [item];
    return items.length ? items : [item];
  };

  const cleanText = (value: string | undefined) => value?.trim() || "";
  const setOptionalText = (element: HTMLElement | null | undefined, value: string) => {
    if (!element) return;
    element.textContent = value;
    element.hidden = !value;
  };

  const updateNavigation = () => {
    const hidden = galleryItems.length < 2;
    if (previous) previous.hidden = hidden;
    if (next) next.hidden = hidden;
  };

  const metadataFor = (item: HTMLElement) => {
    const figure = item.closest("figure");
    const caption = figure?.querySelector("figcaption");
    const profile = item.closest<HTMLElement>(".artist-profile");
    const model = item.closest<HTMLElement>(".model-card");
    const sourceImage = item.querySelector<HTMLImageElement>("img");
    const captionTitle = cleanText(caption?.querySelector("strong")?.textContent || undefined);
    const captionDetail = cleanText(caption?.querySelector("small")?.textContent || undefined);
    const captionPrice = cleanText(caption?.querySelector("b")?.textContent || undefined);
    const suppressProfileMeta = item.hasAttribute("data-gallery-suppress-profile-meta");
    const fallbackTitle = suppressProfileMeta
      ? captionTitle
      : cleanText(profile?.querySelector("h3")?.textContent || model?.querySelector("h3")?.textContent || sourceImage?.alt || "");
    const fallbackDescription = suppressProfileMeta
      ? captionDetail
      : cleanText(profile?.querySelector(".artist-profile__description")?.textContent || "");
    const hasGalleryTitle = item.hasAttribute("data-gallery-title");
    const hasGalleryDescription = item.hasAttribute("data-gallery-description");

    return {
      title: hasGalleryTitle ? cleanText(item.dataset.galleryTitle) : (captionTitle || fallbackTitle),
      description: hasGalleryDescription ? cleanText(item.dataset.galleryDescription) : (captionDetail || fallbackDescription),
      price: cleanText(item.dataset.galleryPrice) || captionPrice,
      link: suppressProfileMeta ? cleanText(item.dataset.galleryLink) : cleanText(item.dataset.galleryLink) || cleanText(profile?.querySelector<HTMLAnchorElement>("a[href]")?.href),
      linkLabel: suppressProfileMeta ? cleanText(item.dataset.galleryLinkLabel) : cleanText(item.dataset.galleryLinkLabel) || cleanText(profile?.querySelector<HTMLAnchorElement>("a[href]")?.textContent || undefined)
    };
  };

  const showImage = (index: number) => {
    const item = galleryItems[index];
    if (!item || !image) return;
    activeIndex = index;
    const sourceImage = item.querySelector<HTMLImageElement>("img");
    const metadata = metadataFor(item);
    if (lightboxAvif) lightboxAvif.srcset = item.dataset.galleryAvif || "";
    if (lightboxWebp) lightboxWebp.srcset = item.dataset.galleryWebp || "";
    if (lightboxAvif) lightboxAvif.sizes = "min(100vw - 44px, 2400px)";
    if (lightboxWebp) lightboxWebp.sizes = "min(100vw - 44px, 2400px)";
    image.src = item.dataset.galleryFallback || item.dataset.gallerySrc || sourceImage?.currentSrc || sourceImage?.src || "";
    image.width = Number(item.dataset.galleryWidth || sourceImage?.naturalWidth || 0) || image.width;
    image.height = Number(item.dataset.galleryHeight || sourceImage?.naturalHeight || 0) || image.height;
    image.alt = item.dataset.galleryAlt || sourceImage?.alt || metadata.title;
    image.style.objectPosition = sourceImage?.style.objectPosition || "50% 50%";
    setOptionalText(title, metadata.title);
    setOptionalText(description, metadata.description);
    setOptionalText(price, metadata.price);
      if (linkSlot) {
        linkSlot.replaceChildren();
        linkSlot.hidden = !metadata.link;

        if (metadata.link) {
          const link = document.createElement("a");
          link.className = "studio-lightbox__link";
          link.href = metadata.link;
          link.target = "_blank";
          link.rel = "noreferrer noopener";
          link.textContent = metadata.linkLabel || (document.documentElement.lang === "hu" ? "Bővebben" : "View more");
          linkSlot.append(link);
        }
      }
    if (counter) counter.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(galleryItems.length).padStart(2, "0")}`;
    updateNavigation();
  };

  const closeLightbox = () => {
    if (!(lightbox instanceof HTMLDialogElement)) return;
    lightbox.close();
  };

  document.querySelectorAll<HTMLElement>("[data-model-card]").forEach((card) => {
    const main = card.querySelector<HTMLButtonElement>("[data-model-main]");
    const mainImage = card.querySelector<HTMLImageElement>(".model-gallery__main-image");
    const thumbs = [...card.querySelectorAll<HTMLButtonElement>("[data-model-thumb]")];
    thumbs.forEach((thumb) => thumb.addEventListener("click", () => {
      if (!main || !mainImage) return;
      main.dataset.gallerySrc = thumb.dataset.galleryFallback || "";
      main.dataset.galleryAvif = thumb.dataset.galleryAvif || "";
      main.dataset.galleryWebp = thumb.dataset.galleryWebp || "";
      main.dataset.galleryFallback = thumb.dataset.galleryFallback || "";
      main.dataset.galleryWidth = thumb.dataset.galleryWidth || "";
      main.dataset.galleryHeight = thumb.dataset.galleryHeight || "";
      main.dataset.galleryAlt = thumb.dataset.modelAlt || "";
      main.dataset.galleryTitle = thumb.dataset.modelTitle || main.dataset.galleryTitle || "";
      mainImage.src = thumb.dataset.modelSrc || "";
      mainImage.srcset = thumb.dataset.modelSrcset || "";
      const mainPicture = mainImage.closest("picture");
      mainPicture?.querySelector<HTMLSourceElement>("source[type='image/avif']")?.setAttribute("srcset", thumb.dataset.modelAvifSrcset || "");
      mainPicture?.querySelector<HTMLSourceElement>("source[type='image/webp']")?.setAttribute("srcset", thumb.dataset.modelWebpSrcset || "");
      mainImage.alt = thumb.dataset.modelAlt || "";
      mainImage.style.objectPosition = thumb.dataset.modelPosition || "50% 50%";
      thumbs.forEach((item) => {
        const active = item === thumb;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", String(active));
      });
    }));
  });

  document.querySelectorAll<HTMLElement>("[data-gallery-image], [data-gallery-trigger]").forEach((item) => item.addEventListener("click", () => {
    if (!(lightbox instanceof HTMLDialogElement)) return;
    lastTrigger = item;
    galleryItems = itemsFor(item);
    const requestedSrc = item.dataset.gallerySrc || "";
    const matchingIndex = requestedSrc ? galleryItems.findIndex((galleryItem) => galleryItem.dataset.gallerySrc === requestedSrc) : -1;
    showImage(matchingIndex >= 0 ? matchingIndex : 0);
    lightbox.showModal();
    lightbox.querySelector<HTMLButtonElement>("[data-lightbox-close]")?.focus();
  }));

  lightbox?.querySelector("[data-lightbox-close]")?.addEventListener("click", closeLightbox);
  previous?.addEventListener("click", () => showImage((activeIndex - 1 + galleryItems.length) % galleryItems.length));
  next?.addEventListener("click", () => showImage((activeIndex + 1) % galleryItems.length));
  lightbox?.addEventListener("click", (event) => { if (event.target === lightbox) closeLightbox(); });
  lightbox?.addEventListener("close", () => window.setTimeout(() => lastTrigger?.focus(), 0));
  lightbox?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      event.preventDefault();
      closeLightbox();
      return;
    }
    if (event.key === "ArrowLeft") {
      event.preventDefault();
      showImage((activeIndex - 1 + galleryItems.length) % galleryItems.length);
    }
    if (event.key === "ArrowRight") {
      event.preventDefault();
      showImage((activeIndex + 1) % galleryItems.length);
    }
  });
  lightbox?.addEventListener("cancel", () => window.setTimeout(() => lastTrigger?.focus(), 0));

  const weddingForm = document.querySelector<HTMLFormElement>("[data-wedding-web3forms]");
  const weddingStatus = weddingForm?.querySelector<HTMLElement>("[data-wedding-status]");
  const setWeddingStatus = (message: string, isError = false) => {
    if (!weddingStatus) return;
    weddingStatus.textContent = message;
    weddingStatus.dataset.error = isError ? "true" : "false";
  };

  if (weddingForm && weddingStatus) {
    const params = new URLSearchParams(window.location.search);
    if (params.get("wedding") === "success") {
      setWeddingStatus(document.documentElement.lang === "hu" ? "Köszönjük, hamarosan jelentkezünk az elérhetőséggel." : "Thank you, we’ll be in touch soon about availability.");
      window.history.replaceState({}, document.title, `${window.location.pathname}#wedding-contact-form`);
    }

    weddingForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitButton = weddingForm.querySelector<HTMLButtonElement>("[type=submit]");
      if (submitButton) submitButton.disabled = true;
      setWeddingStatus(document.documentElement.lang === "hu" ? "Küldés…" : "Sending…");

      try {
        const response = await fetch(weddingForm.action, {
          method: "POST",
          body: new FormData(weddingForm),
          headers: { Accept: "application/json" }
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.message || "Submission failed");
        weddingForm.reset();
        setWeddingStatus(document.documentElement.lang === "hu" ? "Köszönjük, hamarosan jelentkezünk az elérhetőséggel." : "Thank you, we’ll be in touch soon about availability.");
      } catch {
        setWeddingStatus(document.documentElement.lang === "hu" ? "A küldés nem sikerült. Kérjük, írj nekünk e-mailt." : "We couldn’t send your enquiry. Please email us instead.", true);
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  }
</script>
