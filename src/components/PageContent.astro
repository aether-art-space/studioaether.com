---
import { faqGroupsFor, introFor, site, localizedNav } from "../lib/site.mjs";
import { homeContent, studioContent, studioImages, studioGalleryImages, studioBackdropImages, selfieContent, selfieImages, equipmentContent, equipmentImages, equipmentCaptions, propsContent, propsImages, residentArtistContent, residentArtistImages, modelsContent, modelImages, packagesContent, photoPackageSets, commonUpgrades, serviceContent, serviceImages, corporateGalleryImages, specialContent, specialImages, mentoringContent, mentoringImages, seasonalContent, seasonalImages, profileContent, profileImages, postBookingContent, weddingContent, weddingImages, weddingSectionImages, legalContent, homeImages } from "../data/content.mjs";
import ArtistCard from "./ArtistCard.astro";
import CircularCard from "./CircularCard.astro";
import ExtrasCard from "./ExtrasCard.astro";
import GalleryLightbox from "./GalleryLightbox.astro";
import HorizontalMasonryGallery from "./HorizontalMasonryGallery.astro";
import ImageHero from "./ImageHero.astro";
import InfoBox from "./InfoBox.astro";
import ExtrasSection from "./ExtrasSection.astro";
import FaqSection from "./FaqSection.astro";
import PageHero from "./PageHero.astro";
import PriceCard from "./PriceCard.astro";
import PriceSection from "./PriceSection.astro";
import PricingTabs from "./PricingTabs.astro";
import StylistProfile from "./StylistProfile.astro";
import StudioSection from "./StudioSection.astro";

const { page } = Astro.props;
const hu = page.language === "hu";
const faqGroups = faqGroupsFor(page) as Array<[string, any[]]>;
const home = homeContent[hu ? "hu" : "en"];
const studio = studioContent[hu ? "hu" : "en"];
const selfie = selfieContent[hu ? "hu" : "en"];
const selfiePackages = selfie.prices.map((priceItem) => ({
  title: priceItem[0] as string,
  descriptionLines: (priceItem[1] as string[]).map((text) => ({ text })),
  price: priceItem[2] as string
}));
const splitSelfieBoldText = (text: string) => {
  const parts: Array<{ text: string; bold?: boolean }> = [];
  const quoted = /"([^"]+)"/g;
  let cursor = 0;
  let match: RegExpExecArray | null;
  while ((match = quoted.exec(text))) {
    if (match.index > cursor) parts.push({ text: text.slice(cursor, match.index + 1) });
    parts.push({ text: match[1], bold: true }, { text: '"' });
    cursor = match.index + match[0].length;
  }
  if (cursor < text.length) parts.push({ text: text.slice(cursor) });
  return parts;
};
const isEquipment = page.path === "/equipment" || page.path === "/hu/equipment";
const isProps = page.path === "/props" || page.path === "/hu/props";
const collectionPage = isEquipment ? equipmentContent[hu ? "hu" : "en"] : isProps ? propsContent[hu ? "hu" : "en"] : null;
const collectionImages = isEquipment ? equipmentImages : propsImages;
const collectionImageMap = collectionImages as Record<string, Array<{ src: string; alt: string; width?: number; height?: number }>>;
const collectionCaptionMap = (isEquipment ? equipmentCaptions[hu ? "hu" : "en"] : null) as Record<string, Array<{ title: string; detail: string; price: string }>> | null;
const collectionAnchorIds = isEquipment
  ? ["light-sources", "light-modifiers", "other-equipment", "cameras-for-rent", "lenses-for-rent"]
  : ["wardrobe", "props-collection", "furniture-collection"];
const collectionSections = collectionPage?.sections.map((section) => ({
  heading: section.heading,
  subheading: "subheading" in section ? section.subheading : "",
  paragraphs: section.paragraphs,
  galleries: section.galleries.map((gallery) => ({ imageKey: gallery.imageKey, title: ("title" in gallery ? gallery.title : null) as string | null, note: ("note" in gallery ? gallery.note : null) as string[] | null, info: ("info" in gallery ? gallery.info : null) as string | null, infoPrice: ("infoPrice" in gallery ? gallery.infoPrice : null) as string | null }))
})) ?? [];
const artistType = page.path.includes("photographers-budapest") ? "photographers" : page.path.includes("/stylists") ? "stylists" : page.path.includes("make-up-artists") ? "makeup" : null;
const artistPage = artistType ? residentArtistContent[artistType][hu ? "hu" : "en"] : null;
const artistImages = artistType ? residentArtistImages[artistType] : null;
const artistPageAny = artistPage as any;
const artistImagesAny = artistImages as any;
const artistProfiles = artistPageAny?.profiles.map((profile: any) => {
  const source = artistType === "makeup" ? artistImagesAny.profiles[profile.imageIndex] : { image: artistImagesAny[profile.image], gallery: artistImagesAny[profile.gallery] };
  return { ...profile, image: source.image, gallery: source.gallery };
}) ?? [];
const isModels = page.path === "/models-budapest" || page.path === "/hu/models-budapest";
const modelPage = isModels ? modelsContent[hu ? "hu" : "en"] : null;
const modelPageAny = modelPage as any;
const modelPeopleImages = modelImages.people;
const isPackages = page.path === "/packages" || page.path === "/hu/packages";
const packagesPage = isPackages ? packagesContent[hu ? "hu" : "en"] : null;
const packagesPageAny = packagesPage as any;
const serviceType = page.path.includes("commercial-photography") ? "commercial" : page.path.includes("corporate-photography") ? "corporate" : page.path.includes("portrait-photography") ? "portrait" : page.path === "/fitness" || page.path === "/hu/fitness" ? "fitness" : null;
const servicePage = serviceType ? serviceContent[serviceType][hu ? "hu" : "en"] : null;
const servicePageAny = servicePage as any;
const serviceImagesAny: any = serviceType ? (serviceImages as any)[serviceType] : null;
const studioSectionImage = "/images/equipment/EFI08382-bnw-highres.jpg";
const studioSectionImageAlt = hu ? "Budapesti fotóstúdió" : "Aether Art Space Budapest photo studio";
const serviceHeroHeadingId = serviceType === "commercial" ? "commercial-title" : "service-title";
const serviceHeroSubtitle = serviceType === "commercial"
  ? (hu ? "Bízd meg professzionális fotósainkat a kereskedelmi fotóprojekteddel" : "Hire our professional photographers for your commercial photo project")
  : serviceType === "corporate"
    ? servicePageAny?.hero
  : serviceType === "portrait"
    ? servicePageAny?.hero
  : serviceType === "fitness"
    ? servicePageAny?.hero
  : undefined;
const fitnessAudienceImages: any = serviceImages.fitnessAudience;
const specialType = page.path.includes("glamour-boudoir") ? "glamour" : page.path.includes("model-polaroids") ? "models" : page.path.includes("pet-photography") ? "pet" : null;
const specialPage = specialType ? (specialContent as any)[specialType][hu ? "hu" : "en"] : null;
const specialPageAny = specialPage as any;
const specialImagesAny: any = specialType ? (specialImages as any)[specialType] : null;
const modelDetails = specialType === "models" ? specialPageAny.sections.slice(0, -1) : [];
const modelFaceCard = specialType === "models" ? specialPageAny.sections.at(-1) : null;
const isIdPhoto = page.path === "/id-photo" || page.path === "/hu/id-photo";
const idPhotoPackages = isIdPhoto ? [
  {
    title: hu ? "digitális igazolványkép / útlevélkép" : "digital ID / passport photo",
    price: "5.000. HUF",
    features: []
  },
  {
    title: hu ? "digitális + nyomtatott igazolványkép / útlevélkép (4 db)" : "digital + printed ID / passport photo (x4)",
    price: "7.000. HUF",
    features: []
  }
] : [];
const isMentoring = page.path === "/photographer-mentoring-budapest" || page.path === "/hu/photographer-mentoring-budapest";
const mentoringPage: any = isMentoring ? mentoringContent[hu ? "hu" : "en"] : null;
const mentoringBenefits = hu ? [
  { title: "profi mentorok", copy: "Profi fotósok tanítanak türelmesen digitális és analóg fotózásra.", image: mentoringImages.mentors[0] },
  { title: "profi modellek", copy: "Profi modellekkel dolgozhatsz, akik segítenek a saját projekted megformálásában.", image: mentoringImages.mentors[1] },
  { title: "felszerelés a csomagban", copy: "Ha nincs megfelelő felszerelésed, minden szükséges eszközt biztosítunk, vegyszerekkel és laborfelszereléssel együtt.", image: mentoringImages.mentors[2] },
  { title: "rugalmas órák", copy: "A saját tempódban haladhatsz, az órák témáit pedig az igényeidhez igazítjuk.", image: mentoringImages.mentors[3] }
] : [
  { title: "professional mentors", copy: "Our mentors are professional photographers who will teach you with patience about digital and analogue photography.", image: mentoringImages.mentors[0] },
  { title: "pro models", copy: "You can work with professional models who will help you formulate your own projects and bring their ideas to the table.", image: mentoringImages.mentors[1] },
  { title: "gear included", copy: "If you don't have proper gear or just want to try out a different setup, we got you covered. Chemicals and lab equipment is also available.", image: mentoringImages.mentors[2] },
  { title: "flexible classes", copy: "Take your classes whenever you feel like and at the pace you want. If you need something else, we will modify the topics for you.", image: mentoringImages.mentors[3] }
];
const mentoringLessonIntroductions = hu ? [
  "A stúdióban találkozunk, és a valódi fotózás előtt együtt gyakorlunk. Ezt fogod megtanulni:",
  "Együtt fotózunk a stúdióban. Ezt fogod megtanulni:",
  "Együtt digitalizáljuk és fejezzük be a képeidet. Ezt fogod megtanulni:"
] : [
  "We meet you in the studio and practice before the real shoot. You will learn:",
  "We do a photoshoot together in the studio. You will learn:",
  "We will sit together and finish up your images. You will learn:"
];
const seasonalType = page.path.includes("christmas-photoshoot") ? "photoshoot" : page.path.includes("christmas-studio") ? "studio" : null;
const seasonalPage: any = seasonalType ? (seasonalContent as any)[seasonalType][hu ? "hu" : "en"] : null;
const seasonalPageImages: any = seasonalType ? (seasonalImages as any)[seasonalType] : null;
const seasonalPackages = seasonalType === "photoshoot" ? photoPackageSets.christmas[hu ? "hu" : "en"] : [];
const isProfile = page.path.endsWith("photographer-daniel");
const profilePage: any = isProfile ? (profileContent as any)[hu ? "hu" : "en"] : null;
const isPostBooking = page.path.includes("post-booking");
const postBookingPage: any = isPostBooking ? (postBookingContent as any)[hu ? "hu" : "en"] : null;
const isWedding = page.path.includes("wedding-photography");
const weddingPage: any = isWedding ? (weddingContent as any)[hu ? "hu" : "en"] : null;
const weddingWeb3FormsAccessKey = import.meta.env.PUBLIC_WEDDING_WEB3FORMS_ACCESS_KEY || "d92ec586-0336-439d-a756-005f41e36de4";
const weddingContactSuccessUrl = `${site.domain}${page.path}?wedding=success#wedding-contact-form`;
const splitWeddingCoverage = (text: string) => {
  const match = text.match(/^included\s+(in|from)\s+(?:the\s+)?(.+)$/i);
  if (!match) return { priceLabel: "included in:", price: text };
  return { priceLabel: `included ${match[1]}:`, price: `${match[2].charAt(0).toUpperCase()}${match[2].slice(1)}` };
};
const splitWeddingOptionPrice = (text: string) => {
  const match = text.match(/^add(?:\s+this)?\s+to\s+any\s+package\s+for\s+(.+)$/i);
  return { priceLabel: "add to any package for", price: match?.[1] ?? text };
};
const weddingCoverageCards = isWedding ? weddingPage.coverage.map((item: string[], index: number) => ({ title: item[0], description: item[1], ...splitWeddingCoverage(item[2]), image: weddingSectionImages.coverage[index] })) : [];
const weddingPrimaryOptionCards = isWedding ? weddingPage.options.slice(0, 2).map((item: string[], index: number) => ({ title: item[0], description: item[1], ...splitWeddingOptionPrice(item[2]), image: weddingSectionImages.options[index] })) : [];
const weddingAddonCards = isWedding ? weddingPage.options.slice(2).map((item: string[], index: number) => ({ title: item[0], description: item[1], ...splitWeddingOptionPrice(item[2]), image: weddingSectionImages.options[index + 2] })) : [];
const weddingPackageFeatureBreaks = [[2], [4], [6]];
const legalPage: any = page.section === "legal" ? (legalContent as any)[hu ? "hu" : "en"] : null;
const bookingExtras = hu ? [["Papír háttér", "csak ha ráléptek", "3000 Ft"], ["Smink", "profi sminkeseinktől", "15.000.Ft-tól"], ["Nagy Angyal Szárnyak", "fehér, vagy fekete / 1m+", "8.000.Ft"], ["Asszisztencia", "segítünk magyarul, vagy angolul", "4.000.Ft / óra"], ["Styling", "dolgozz profi stylistjainkkal", "35.000.Ft-tól"], ["Különleges Ruhák", "Menyasszonyi ruha, Népviselet, stb...", "5000Ft-tól"], ["Kamera bérlés", "analóg vagy digitális kamerák és filmek", "4000-9000 Ft"], ["Fotómodellek", "tapasztalt modellek", "15.000.Ft / órától"], ["Füstgép", "folyadékkal együtt", "5000Ft"], ["Akvárium", "bele fér egy ember - vízzel töltve", "39.000.Ft"]] : [["Paper Backdrop", "applies if you step on it", "3.000. HUF"], ["Make-up", "work with our pro make-up artists", "from 15.000. HUF"], ["Large Angel Wings", "black or white / 1m+", "8.000. HUF"], ["Assistance", "we help you in Hungarian or English", "4.000. HUF / hour"], ["Styling", "work with our pro stylist", "from 35.000. HUF"], ["Unique Outfits", "Bridal Dress, Folk Dress, etc.", "from 5.000. HUF"], ["Camera Rental", "analog or digital cameras and films", "4.000.-9.000. HUF"], ["Photo Models", "work with our pro models", "from 15.000. HUF / hour"], ["Fog Machine", "with fog juice included", "5.000. HUF"], ["Aquarium", "fits a human - filled with water", "39.000. HUF"]];
const bookingExtraItems = bookingExtras.map(([title, priceLabel, price]) => ({ title, priceLabel, price }));
const profilePackages = hu ? [{ title: "Kis Studiós Fotózás", description: "Válaszd ezt a csomagot, ha új profilképet, önéletrajzot szeretnél, vagy csak egy egyszerű stúdiófotózást szeretnél kipróbálni.", price: "39.000. HUF", features: ["stúdióbérleti díjat tartalmazza", "6 magazin minőségű fénykép", "1 outfit", "1 stúdió beállítás", "1 modell"] }, { title: "Standard Studiós Fotózás", description: "Tökéletes több öltözékes vagy több stílusú stúdiófotózáshoz. Párok vagy barátok számára is jó megoldás.", price: "59.000. HUF", features: ["stúdióbérleti díjat tartalmazza", "15 magazin minőségű fénykép", "legfeljebb 3 öltözék", "legfeljebb 3 stúdióbeállítás", "1-2 modell"] }, { title: "All-inclusive Studiós Fotózás", description: "Ha a megszokottól eltérő, tökéletes képek szép sorozatát szeretnéd, ez az ajánlat neked szól. Bonyolult díszletekkel, különleges világítással vagy csoportképekkel is bármit megvalósítunk, amit elképzelsz.", price: "79.000. HUF", features: ["stúdióbérleti díjat tartalmazza", "21 magazin minőségű fénykép", "legfeljebb 3 öltözék", "legfeljebb 3 stúdióbeállítás", "egy modelltől csoportokig"] }] : [{ title: "Small Studio Photoshoot", description: "Pick this package if you want some new profile pictures, CV pictures or just want to try out a simple studio shoot.", price: "39.000. HUF", features: ["studio rent included", "6 magazine quality photographs", "single outfit", "single studio setting", "single model"] }, { title: "Standard Studio Photoshoot", description: "Perfect for a studio shoot with multiple outfits or styles. Also a good solution for couples or friends.", price: "59.000. HUF", features: ["studio rent included", "15 magazine quality photographs", "up to 3 outfits", "up to 3 studio settings", "1-2 models"] }, { title: "All-inclusive Studio Photoshoot", description: "If you want a nice set of perfect pictures that are beyond the usual, this offer is for you. Including complicated sets, special lighting or group photos - we can do anything you can imagine!", price: "79.000. HUF", features: ["studio rent included", "21 magazine quality photographs", "up to 3 outfits", "up to 3 studio settings", "from a single model to groups"] }];
const bookingPackages = hu ? [
  { title: "Kedvezményes stúdió idősávok", titleLines: ["Kedvezményes", "Stúdió idősávok"], descriptionLines: [{ text: "hétfőtől csütörtökig", bold: true }, { text: "9:00-18:00" }, { text: "" }, { text: "" }], price: "7.000. Ft/óra" },
  { title: "Standard stúdió idősávok", titleLines: ["Standard", "Stúdió idősávok"], descriptionLines: [{ text: "hétfőtől csütörtökig", bold: true }, { text: "18:00-22:00 között" }, { text: "péntek és hétvége", bold: true }, { text: "10:00-22:00" }], price: "8.000. Ft/óra" },
  { title: "10 órás bérlet", titleLines: ["10 órás bérlet"], titleAccent: "akár 25% kedvezmény!", descriptionLines: [{ text: "Bármelyik nap", bold: true }, { text: "10:00-22:00 között" }, { text: "" }, { text: "Óránként felbontható" }], price: "60.000. Ft" }
] : [
  { title: "Discounted Studio Timeslots", titleLines: ["Discounted", "Studio Timeslots"], descriptionLines: [{ text: "Monday to Thursday", bold: true }, { text: "9:00 - 18:00" }, { text: "" }, { text: "" }], price: "7.000. HUF / hour" },
  { title: "Standard Studio Timeslots", titleLines: ["Standard", "Studio Timeslots"], descriptionLines: [{ text: "Monday to Thursday", bold: true }, { text: "18:00-22:00" }, { text: "Friday & Weekend", bold: true }, { text: "9:00 - 22:00" }], price: "8.000. HUF / hour" },
  { title: "10 Hour Membership", titleLines: ["10 hour Membership"], titleAccent: "SAVE UP TO 37%", descriptionLines: [{ text: "Any day", bold: true }, { text: "10:00-22:00" }, { text: "" }, { text: "Can be broken up by the hour" }], price: "60.000. HUF" }
];
const servicePackages = serviceType === "portrait" ? photoPackageSets.portrait[hu ? "hu" : "en"] : servicePageAny?.packages ?? [];
const specialPackages = specialType ? (photoPackageSets as any)[specialType][hu ? "hu" : "en"] : [];
const serviceUpgrades = commonUpgrades[hu ? "hu" : "en"];
const serviceUpgradesWithLinks = serviceUpgrades.map((item: any) => ({ ...item, linkLabel: item.href?.startsWith("mailto:") ? (hu ? "kérj ajánlatot" : "ask for an offer") : (hu ? "bővebben" : "learn more") }));
const serviceLinks = localizedNav(page.language).flatMap((group) => group.links)
  .filter(([path]) => path !== page.path)
  .slice(0, 4);
const relatedHref = hu ? "/hu/packages" : "/packages";
---

{page.section === "home" ? (
  <>
    <ImageHero variant="home" headingId="home-title" title={page.h1} image={homeImages.hero} icon={{ ...homeImages.icon, width: 450, height: 436 }}>
      <a class="button button--inverted" data-gtag-event="booking_click" data-gtag-location="home" href={site.bookingUrl}><span class="home-hero__cta-desktop">{hu ? "foglalás" : "book the studio"}</span><span class="home-hero__cta-mobile">{hu ? "foglalás" : "book the photostudio"}</span></a>
    </ImageHero>
    <section class="home-favourite" aria-labelledby="favourite-title">
      <div class="home-favourite__intro">
        <h2 id="favourite-title">{hu ? <>az új kedvenc<br class="home-mobile-break" />{" "}fotóstúdiód</> : <>your new favourite<br class="home-mobile-break" />{" "}photostudio</>}</h2>
        <p>{home.introHeading}</p>
      </div>
      <div class="home-feature-grid">
        {home.features.map(([title, copy, href, label], index) => <CircularCard variant="feature" title={title} copy={copy} href={href} linkLabel={label} image={homeImages.features[index]} />)}
      </div>
    </section>
    <section class="studio-showcase" aria-labelledby="studio-showcase-title">
      <div class="studio-showcase__copy">
        <h2 id="studio-showcase-title">{home.studioShowcaseTitle}</h2>
        <p>{home.studioShowcaseIntro}</p>
        <p>{home.studioShowcaseBody}</p>
        <a class="button button--secondary studio-showcase__more" href={hu ? "/hu/studio" : "/studio"}>{home.studioShowcaseCta}</a>
      </div>
      <div class="studio-showcase__visuals">
        <div class="studio-showcase__gallery" data-gallery aria-label={hu ? "Képgaléria a stúdióról" : "Photo gallery of the studio"}>
          {homeImages.creatingArt.map((image, index) => <button class="studio-showcase__gallery-item" type="button" data-gallery-image data-gallery-index={index} data-gallery-src={image.src} data-gallery-alt={image.alt} aria-label={hu ? `Kép megnyitása: ${index + 1}` : `Open image ${index + 1}`}>
            <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
          </button>)}
        </div>
        <aside class="studio-showcase__rent">
          <h3>{hu ? "Stúdióbérlés" : "Studio Rent"}</h3>
          <p>{hu ? <>7.000 HUF<br />/ órától</> : <>starting from<br />7.000. HUF / hour</>}</p>
          <a class="button button--dark studio-showcase__book" data-gtag-event="booking_click" data-gtag-location="home-studio-showcase" href={site.bookingUrl}>{hu ? "foglald le a stúdiót" : "book the photostudio"}</a>
        </aside>
      </div>
    </section>
    <GalleryLightbox label={hu ? "Stúdió képgaléria" : "Studio photo gallery"} hu={hu} variant="home" />
    <section class="beginner-section" aria-labelledby="beginner-title">
      <div class="beginner-section__main">
        <h2 id="beginner-title">{home.beginnerHeading}</h2>
        <p class="beginner-section__lead">{home.beginnerLead}</p>
        <div class="beginner-section__proof">{home.beginnerProof.map((paragraph, index) => <p>{index === 1 ? <strong>{paragraph}</strong> : paragraph}</p>)}</div>
        <ul class="beginner-section__steps">{home.beginnerSteps.map((step) => <li>{step}</li>)}</ul>
        <p class="beginner-section__cta"><strong>{home.beginnerCtaLead}</strong>{home.beginnerCtaTail}</p>
      </div>
      <div class="beginner-section__testimonials">
        <blockquote><p>{home.beginnerQuote}</p><footer>{home.beginnerAttribution}</footer></blockquote>
        <blockquote><p>{home.beginnerQuoteSecond}</p><footer>{home.beginnerAttributionSecond}</footer></blockquote>
      </div>
    </section>
    <section class="home-artists" aria-labelledby="artists-title">
      <div class="home-artists__intro">
        <h2 id="artists-title">{home.artistsHeading}</h2>
        <p>{home.artistsLead}</p>
      </div>
      <div class="home-artists__grid">{home.artists.map(([title, copy, href, label], index) => <CircularCard variant="artist" title={title} copy={copy} href={href} linkLabel={label} image={{ ...homeImages.artists[index], alt: hu ? homeImages.artists[index].altHu : homeImages.artists[index].alt }} />)}</div>
    </section>
    <section class="home-services" aria-labelledby="services-title">
      <div class="home-services__intro">
        <h2 id="services-title">{home.photographersHeading}</h2>
        <p>{home.photographersCopy}</p>
      </div>
      <div class="home-services__grid">{home.photographyServices.map(([title, href, label], index) => <CircularCard variant="service" title={title} href={href} linkLabel={label} image={homeImages.photographers[index]} />)}</div>
      {hu ? <p class="home-services__packages">{home.packagesCopy}</p> : <a class="home-services__packages" href="/photographers-budapest">{home.packagesCopy}</a>}
    </section>
  </>
) : page.path === "/studio" || page.path === "/hu/studio" ? (
  <>
    <PageHero variant="studio" headingId="studio-title" title={page.h1} lead={studio.eyebrow}>
      <div class="studio-intro__copy">
        <p>{studio.paragraphs[0]}</p>
        <p>{studio.paragraphs[1]}</p>
      </div>
    </PageHero>
    <section class="studio-overview" aria-labelledby="studio-facts-title">
      <div class="studio-overview__floorplan"><img src={studioImages[0].src} alt={hu ? "fotóstúdió alaprajz" : studioImages[0].alt} width={studioImages[0].width} height={studioImages[0].height} loading="lazy" decoding="async" /></div>
      <div class="studio-overview__facts">
        <h2 id="studio-facts-title">{studio.heading}</h2>
        <ul>{studio.facts.map((fact) => <li><strong>{fact.lead}</strong>{fact.tail}</li>)}</ul>
      </div>
