<script>
  const lightbox = document.querySelector<HTMLDialogElement>("[data-studio-lightbox]");
  const image = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const title = lightbox?.querySelector<HTMLElement>("[data-lightbox-title]");
  const description = lightbox?.querySelector<HTMLElement>("[data-lightbox-description]");
  const price = lightbox?.querySelector<HTMLElement>("[data-lightbox-price]");
  const link = lightbox?.querySelector<HTMLAnchorElement>("[data-lightbox-link]");
  const counter = lightbox?.querySelector<HTMLElement>("[data-lightbox-counter]");
  let galleryItems: HTMLElement[] = [];
  let activeIndex = 0;
  let lastTrigger: HTMLElement | null = null;

  const galleryFor = (item: HTMLElement) =>
    item.closest<HTMLElement>("[data-gallery]") ||
    item.closest<HTMLElement>("[data-horizontal-gallery]") ||
    item.closest<HTMLElement>("[class*='gallery']");
  const itemsFor = (item: HTMLElement) => {
    const gallery = galleryFor(item);
    const items = gallery ? [...gallery.querySelectorAll<HTMLElement>("[data-gallery-image]")] : [item];
    return items.length ? items : [item];
  };

  const cleanText = (value: string | undefined) => value?.trim() || "";
  const setOptionalText = (element: HTMLElement | null | undefined, value: string) => {
    if (!element) return;
    element.textContent = value;
    element.hidden = !value;
  };

  const metadataFor = (item: HTMLElement) => {
    const figure = item.closest("figure");
    const caption = figure?.querySelector("figcaption");
    const profile = item.closest<HTMLElement>(".artist-profile");
    const model = item.closest<HTMLElement>(".model-card");
    const sourceImage = item.querySelector<HTMLImageElement>("img");
    const captionTitle = cleanText(caption?.querySelector("strong")?.textContent || undefined);
    const captionDetail = cleanText(caption?.querySelector("small")?.textContent || undefined);
    const captionPrice = cleanText(caption?.querySelector("b")?.textContent || undefined);
    const fallbackTitle = cleanText(profile?.querySelector("h3")?.textContent || model?.querySelector("h3")?.textContent || sourceImage?.alt || "");
    const fallbackDescription = cleanText(profile?.querySelector(".artist-profile__description")?.textContent || "");
    const hasGalleryTitle = item.hasAttribute("data-gallery-title");
    const hasGalleryDescription = item.hasAttribute("data-gallery-description");

    return {
      title: hasGalleryTitle ? cleanText(item.dataset.galleryTitle) : (captionTitle || fallbackTitle),
      description: hasGalleryDescription ? cleanText(item.dataset.galleryDescription) : (captionDetail || fallbackDescription),
      price: cleanText(item.dataset.galleryPrice) || captionPrice,
      link: cleanText(item.dataset.galleryLink) || cleanText(profile?.querySelector<HTMLAnchorElement>("a[href]")?.href),
      linkLabel: cleanText(item.dataset.galleryLinkLabel) || cleanText(profile?.querySelector<HTMLAnchorElement>("a[href]")?.textContent || undefined)
    };
  };

  const showImage = (index: number) => {
    const item = galleryItems[index];
    if (!item || !image) return;
    activeIndex = index;
    const sourceImage = item.querySelector<HTMLImageElement>("img");
    const metadata = metadataFor(item);
    image.src = item.dataset.gallerySrc || sourceImage?.currentSrc || sourceImage?.src || "";
    image.alt = item.dataset.galleryAlt || sourceImage?.alt || metadata.title;
    image.style.objectPosition = sourceImage?.style.objectPosition || "50% 50%";
    setOptionalText(title, metadata.title);
    setOptionalText(description, metadata.description);
    setOptionalText(price, metadata.price);
    if (link) {
      link.hidden = !metadata.link;
      if (metadata.link) {
        link.href = metadata.link;
        link.textContent = metadata.linkLabel || "View more";
      } else {
        link.removeAttribute("href");
        link.textContent = "";
      }
    }
    if (counter) counter.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(galleryItems.length).padStart(2, "0")}`;
  };

  const closeLightbox = () => {
    if (!(lightbox instanceof HTMLDialogElement)) return;
    lightbox.close();
    lastTrigger?.focus();
  };

  document.querySelectorAll<HTMLElement>("[data-model-card]").forEach((card) => {
    const main = card.querySelector<HTMLButtonElement>("[data-model-main]");
    const mainImage = card.querySelector<HTMLImageElement>("[data-model-main-image]");
    const thumbs = [...card.querySelectorAll<HTMLButtonElement>("[data-model-thumb]")];
    thumbs.forEach((thumb) => thumb.addEventListener("click", () => {
      if (!main || !mainImage) return;
      main.dataset.gallerySrc = thumb.dataset.modelSrc || "";
      main.dataset.galleryAlt = thumb.dataset.modelAlt || "";
      main.dataset.galleryTitle = thumb.dataset.modelTitle || main.dataset.galleryTitle || "";
      mainImage.src = thumb.dataset.modelSrc || "";
      mainImage.alt = thumb.dataset.modelAlt || "";
      mainImage.style.objectPosition = thumb.dataset.modelPosition || "50% 50%";
      thumbs.forEach((item) => {
        const active = item === thumb;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", String(active));
      });
    }));
  });

  document.querySelectorAll<HTMLElement>("[data-gallery-image], [data-gallery-trigger]").forEach((item) => item.addEventListener("click", () => {
    if (!(lightbox instanceof HTMLDialogElement)) return;
    lastTrigger = item;
    galleryItems = itemsFor(item);
    const requestedSrc = item.dataset.gallerySrc || "";
    const matchingIndex = requestedSrc ? galleryItems.findIndex((galleryItem) => galleryItem.dataset.gallerySrc === requestedSrc) : -1;
    showImage(matchingIndex >= 0 ? matchingIndex : 0);
    lightbox.showModal();
  }));

  lightbox?.querySelector("[data-lightbox-close]")?.addEventListener("click", closeLightbox);
  lightbox?.querySelector("[data-lightbox-previous]")?.addEventListener("click", () => showImage((activeIndex - 1 + galleryItems.length) % galleryItems.length));
  lightbox?.querySelector("[data-lightbox-next]")?.addEventListener("click", () => showImage((activeIndex + 1) % galleryItems.length));
  lightbox?.addEventListener("click", (event) => { if (event.target === lightbox) lightbox.close(); });
  lightbox?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      event.preventDefault();
      closeLightbox();
      return;
    }
    if (event.key === "ArrowLeft") {
      event.preventDefault();
      showImage((activeIndex - 1 + galleryItems.length) % galleryItems.length);
    }
    if (event.key === "ArrowRight") {
      event.preventDefault();
      showImage((activeIndex + 1) % galleryItems.length);
    }
  });
  lightbox?.addEventListener("cancel", () => window.setTimeout(() => lastTrigger?.focus(), 0));
</script>
