      <section class="service-clients"><h2>{servicePageAny.clients}</h2><div>{serviceImages.clients.map((imageData: any) => <img src={imageData.src} alt={imageData.alt} width="150" height="150" loading="lazy" decoding="async" />)}</div></section>
      <FaqSection className="service-faq service-faq--corporate" heading={servicePageAny.faqHeading} items={servicePageAny.faq} headingId="corporate-faq-title" />
    </>}
    <GalleryLightbox label={hu ? "Szolgáltatási galéria" : "Service gallery"} hu={hu} />
  </>
) : page.path === "/post-booking" || page.path === "/hu/post-booking" ? (
  <>
    <PageHero variant="service" headingId="post-booking-title" title={page.h1} eyebrow={hu ? "foglalás visszaigazolása" : "booking confirmation"} lead={hu ? "Hamarosan jelentkezünk a foglalásod részleteivel." : "We will be in touch shortly with the details of your booking."} />
    <section class="callout"><h2>{hu ? "Köszönjük, hogy az aether art space-t választottad." : "Thank you for choosing aether art space."}</h2><a class="button button--dark" href={hu ? "/hu" : "/"}>{hu ? "vissza a főoldalra" : "back to home"}</a></section>
  </>
) : page.section === "booking" ? (
  <>
    <PageHero variant="service" headingId="booking-title" title={page.h1} description={[hu ? "Az Aether Art Space-ben igyekszünk elérhető árakat kínálni, hogy te az igazán fontos dolgokra koncentrálhass – a fotózás mögötti kreativitásra." : "At aether art space, we offer fair and affordable pricing, so you can focus on what matters most – the creativity behind your shoot.", hu ? "Stúdiónk úgy van kialakítva, hogy támogassa a kreatív folyamatot, rugalmas csomagokat kínálva, amelyek különböző igényekhez igazodnak, legyen szó modellről, fotósról vagy vállalkozásról, aki lenyűgöző vizuális anyagot szeretne készíteni." : "Our studio is designed to elevate the creative process, with flexible packages that cater to different needs, whether you're a model, photographer, or business looking to capture stunning visuals.", hu ? "Ezen kívül számos kiegészítőt kínálunk helyben, kizárólag a budapesti stúdiónkban, mint például analóg fényképezőgép bérlés, ruhák, filmek és még sok más, hogy segítsünk életre kelteni a víziódat." : "We also offer a variety of extras on-site exclusive to our studio in Budapest, including analogue camera rentals, clothing, film, and more, to help bring your vision to life."]} />
    <PriceSection id="studio-pricing" className="booking-price-section" gridClassName="booking-price-grid" packages={bookingPackages} headingId="booking-prices-title" ariaLabel={hu ? "Stúdióbérlés árak" : "Studio rental rates"}>
      <PricingTabs slot="tabs" language={page.language} active="studio" />
    </PriceSection>
    <InfoBox class="booking-note">
      <ul>
        {hu ? <>
          <li>Nyitvatartási időn kívül 10.000. HUF áron bérelhető a studió 0-24 - <a href="mailto:photostudio.aether@gmail.com?subject=rent%20outside%20work%20hours">dobj egy emailt</a></li>
          <li>5+ fős forgatások, castingok és hasonlók 10.000.Ft / óra áron elérhetőek.</li>
          <li>Sminkeléshez fél áron bérelheted ki a studiót - ha a mi sminkeseinkkel dolgozol, akkor sminkelés idejére ingyenesen!</li>
        </> : <>
          <li>The studio can be rented outside work hours for 10.000. HUF / hour - <a href="mailto:photostudio.aether@gmail.com?subject=rent%20outside%20work%20hours">drop us an email</a></li>
          <li>5+ participant filmings, castings and similar cost 10.000. HUF / hour</li>
          <li>For make-up you can rent the studio for half price - or if you work with our make-up artists, you can use it for free!</li>
        </>}
      </ul>
    </InfoBox>
    <ExtrasSection className="booking-extras-section" heading={hu ? "Extrák" : "Extras"} intro={[hu ? "Bővítsd a foglalásodat ezekkel az opcionális extrákkal" : "Upgrade your booking with these optional extras"]} items={bookingExtraItems} />
    <InfoBox class="booking-extras-note"><p>{hu ? "Minden egyéb bútor, kellék vagy viselhető tárgy a stúdiónkban INGYENES." : "Any other furniture, prop or wearable in our studio is for FREE."}</p></InfoBox>
  </>
) : page.section === "faq" ? (
  <>
    <PageHero variant="service" headingId="faq-title" title={page.h1} subtitle={introFor(page)} />
    <FaqSection groups={faqGroups} continuous className="faq-section--standalone" />
  </>
) : page.section === "legal" ? (
  <>
    <PageHero variant="service" headingId="legal-title" title={page.h1} eyebrow={hu ? "jogi információ" : "legal information"} description={legalPage.intro}>
      <p class="page-hero__meta">{legalPage.lastUpdated}</p>
    </PageHero>
    <section class="legal-copy">{legalPage.sections.map((section: any) => <section><h2>{section[0]}</h2>{section[1].map((paragraph: string) => <p>{paragraph}</p>)}</section>)}</section>
  </>
) : page.path.endsWith("photographer-daniel") ? (
  <>
    <PageHero variant="service" headingId="profile-title" title={page.h1} eyebrow={hu ? "fotós profil" : "photographer profile"} lead={hu ? "Dániel Z. Aczél fotós és az aether art space alapítója Budapesten." : "Dániel Z. Aczél is a photographer and the founder of aether art space in Budapest."}>
      <div class="page-hero__actions"><a class="button" href={`mailto:${site.email}`}>{hu ? "kapcsolat" : "contact the studio"}</a><a class="text-link" href={hu ? "/hu/photographers-budapest" : "/photographers-budapest"}>{hu ? "rezidens fotósok" : "resident photographers"}</a></div>
    </PageHero>
    <section class="split-copy"><div><h2>{hu ? "Fotózás, tanítás és közös stúdió" : "Photography, teaching and a shared studio"}</h2><p>{hu ? "Ezt a sitemapból is elérhető profilt a migráció alatt megőrizzük." : "This sitemap-discovered profile is preserved during migration."}</p></div><div class="audit-note">{page.action}</div></section>
  </>
) : (
  <>
    <section class="hero"><p class="eyebrow">{page.purpose}</p><h1>{page.h1}</h1><p class="hero-lead">{introFor(page)}</p><div class="actions"><a class="button" data-gtag-event="booking_click" data-gtag-location="service" href={site.bookingUrl}>{hu ? "érdekel a foglalás" : "check availability"}</a><a class="text-link" href={relatedHref}>{hu ? "csomagok megtekintése" : "view photography packages"}</a></div></section>
    <section class="split-copy"><div class="visual-card"><span>budapest</span><strong>aether<br />art space</strong></div><div><p class="eyebrow">{hu ? "a lehetőségek" : "made for the process"}</p><h2>{page.h1}</h2><p>{hu ? `Az ${page.purpose.toLowerCase()} szolgáltatást a budapesti aether art space-ben úgy alakítottuk ki, hogy az alkotáshoz szükséges tér és figyelem egy helyen legyen.` : `Our ${page.purpose.toLowerCase()} offering is built around a calm, flexible studio environment with the space and attention your project needs.`}</p><p>{hu ? "A pontos részletekért, elérhetőségért és személyre szabott ajánlatért írj nekünk." : "Contact us for details, availability and a tailored recommendation."}</p><a class="text-link" href={`mailto:${site.email}`}>{hu ? "írj nekünk" : "send us a message"}</a></div></section>
    <section class="related"><p class="eyebrow">{hu ? "kapcsolódó oldalak" : "continue exploring"}</p><div class="related-links">{serviceLinks.map(([path, label]) => <a class="text-link" href={path}>{label}</a>)}</div></section>
  </>
)}

<script>
  const lightbox = document.querySelector<HTMLDialogElement>("[data-studio-lightbox]");
  const image = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const title = lightbox?.querySelector<HTMLElement>("[data-lightbox-title]");
  const description = lightbox?.querySelector<HTMLElement>("[data-lightbox-description]");
  const price = lightbox?.querySelector<HTMLElement>("[data-lightbox-price]");
  const link = lightbox?.querySelector<HTMLAnchorElement>("[data-lightbox-link]");
  const counter = lightbox?.querySelector<HTMLElement>("[data-lightbox-counter]");
  let galleryItems: HTMLElement[] = [];
  let activeIndex = 0;
  let lastTrigger: HTMLElement | null = null;

  const galleryFor = (item: HTMLElement) =>
    item.closest<HTMLElement>("[data-gallery]") ||
    item.closest<HTMLElement>("[data-horizontal-gallery]") ||
    item.closest<HTMLElement>("[class*='gallery']");
  const itemsFor = (item: HTMLElement) => {
    const gallery = galleryFor(item);
    const items = gallery ? [...gallery.querySelectorAll<HTMLElement>("[data-gallery-image]")] : [item];
    return items.length ? items : [item];
  };

  const cleanText = (value: string | undefined) => value?.trim() || "";
  const setOptionalText = (element: HTMLElement | null | undefined, value: string) => {
    if (!element) return;
    element.textContent = value;
    element.hidden = !value;
  };

  const metadataFor = (item: HTMLElement) => {
    const figure = item.closest("figure");
    const caption = figure?.querySelector("figcaption");
    const profile = item.closest<HTMLElement>(".artist-profile");
    const model = item.closest<HTMLElement>(".model-card");
    const sourceImage = item.querySelector<HTMLImageElement>("img");
    const captionTitle = cleanText(caption?.querySelector("strong")?.textContent || undefined);
    const captionDetail = cleanText(caption?.querySelector("small")?.textContent || undefined);
    const captionPrice = cleanText(caption?.querySelector("b")?.textContent || undefined);
    const fallbackTitle = cleanText(profile?.querySelector("h3")?.textContent || model?.querySelector("h3")?.textContent || sourceImage?.alt || "");
    const fallbackDescription = cleanText(profile?.querySelector(".artist-profile__description")?.textContent || "");
    const hasGalleryTitle = item.hasAttribute("data-gallery-title");
    const hasGalleryDescription = item.hasAttribute("data-gallery-description");

    return {
      title: hasGalleryTitle ? cleanText(item.dataset.galleryTitle) : (captionTitle || fallbackTitle),
      description: hasGalleryDescription ? cleanText(item.dataset.galleryDescription) : (captionDetail || fallbackDescription),
      price: cleanText(item.dataset.galleryPrice) || captionPrice,
      link: cleanText(item.dataset.galleryLink) || cleanText(profile?.querySelector<HTMLAnchorElement>("a[href]")?.href),
      linkLabel: cleanText(item.dataset.galleryLinkLabel) || cleanText(profile?.querySelector<HTMLAnchorElement>("a[href]")?.textContent || undefined)
    };
  };

  const showImage = (index: number) => {
    const item = galleryItems[index];
    if (!item || !image) return;
    activeIndex = index;
    const sourceImage = item.querySelector<HTMLImageElement>("img");
    const metadata = metadataFor(item);
    image.src = item.dataset.gallerySrc || sourceImage?.currentSrc || sourceImage?.src || "";
    image.alt = item.dataset.galleryAlt || sourceImage?.alt || metadata.title;
    image.style.objectPosition = sourceImage?.style.objectPosition || "50% 50%";
    setOptionalText(title, metadata.title);
    setOptionalText(description, metadata.description);
    setOptionalText(price, metadata.price);
    if (link) {
      link.hidden = !metadata.link;
      if (metadata.link) {
        link.href = metadata.link;
        link.textContent = metadata.linkLabel || "View more";
      } else {
        link.removeAttribute("href");
        link.textContent = "";
      }
    }
    if (counter) counter.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(galleryItems.length).padStart(2, "0")}`;
  };

  const closeLightbox = () => {
    if (!(lightbox instanceof HTMLDialogElement)) return;
    lightbox.close();
    lastTrigger?.focus();
  };

  document.querySelectorAll<HTMLElement>("[data-model-card]").forEach((card) => {
    const main = card.querySelector<HTMLButtonElement>("[data-model-main]");
    const mainImage = card.querySelector<HTMLImageElement>("[data-model-main-image]");
    const thumbs = [...card.querySelectorAll<HTMLButtonElement>("[data-model-thumb]")];
    thumbs.forEach((thumb) => thumb.addEventListener("click", () => {
      if (!main || !mainImage) return;
      main.dataset.gallerySrc = thumb.dataset.modelSrc || "";
      main.dataset.galleryAlt = thumb.dataset.modelAlt || "";
      main.dataset.galleryTitle = thumb.dataset.modelTitle || main.dataset.galleryTitle || "";
      mainImage.src = thumb.dataset.modelSrc || "";
      mainImage.alt = thumb.dataset.modelAlt || "";
      mainImage.style.objectPosition = thumb.dataset.modelPosition || "50% 50%";
      thumbs.forEach((item) => {
        const active = item === thumb;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", String(active));
      });
    }));
  });

  document.querySelectorAll<HTMLElement>("[data-gallery-image], [data-gallery-trigger]").forEach((item) => item.addEventListener("click", () => {
    if (!(lightbox instanceof HTMLDialogElement)) return;
    lastTrigger = item;
    galleryItems = itemsFor(item);
    const requestedSrc = item.dataset.gallerySrc || "";
    const matchingIndex = requestedSrc ? galleryItems.findIndex((galleryItem) => galleryItem.dataset.gallerySrc === requestedSrc) : -1;
    showImage(matchingIndex >= 0 ? matchingIndex : 0);
    lightbox.showModal();
  }));

  lightbox?.querySelector("[data-lightbox-close]")?.addEventListener("click", closeLightbox);
  lightbox?.querySelector("[data-lightbox-previous]")?.addEventListener("click", () => showImage((activeIndex - 1 + galleryItems.length) % galleryItems.length));
  lightbox?.querySelector("[data-lightbox-next]")?.addEventListener("click", () => showImage((activeIndex + 1) % galleryItems.length));
  lightbox?.addEventListener("click", (event) => { if (event.target === lightbox) lightbox.close(); });
  lightbox?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      event.preventDefault();
      closeLightbox();
      return;
    }
    if (event.key === "ArrowLeft") {
      event.preventDefault();
      showImage((activeIndex - 1 + galleryItems.length) % galleryItems.length);
    }
    if (event.key === "ArrowRight") {
      event.preventDefault();
      showImage((activeIndex + 1) % galleryItems.length);
    }
  });
  lightbox?.addEventListener("cancel", () => window.setTimeout(() => lastTrigger?.focus(), 0));

  const weddingForm = document.querySelector<HTMLFormElement>("[data-wedding-web3forms]");
  const weddingStatus = weddingForm?.querySelector<HTMLElement>("[data-wedding-status]");
  const setWeddingStatus = (message: string, isError = false) => {
    if (!weddingStatus) return;
    weddingStatus.textContent = message;
    weddingStatus.dataset.error = isError ? "true" : "false";
  };

  if (weddingForm && weddingStatus) {
    const params = new URLSearchParams(window.location.search);
    if (params.get("wedding") === "success") {
      setWeddingStatus(document.documentElement.lang === "hu" ? "Köszönjük, hamarosan jelentkezünk az elérhetőséggel." : "Thank you, we’ll be in touch soon about availability.");
      window.history.replaceState({}, document.title, `${window.location.pathname}#wedding-contact-form`);
    }

    weddingForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitButton = weddingForm.querySelector<HTMLButtonElement>("[type=submit]");
      if (submitButton) submitButton.disabled = true;
      setWeddingStatus(document.documentElement.lang === "hu" ? "Küldés…" : "Sending…");

      try {
        const response = await fetch(weddingForm.action, {
          method: "POST",
          body: new FormData(weddingForm),
          headers: { Accept: "application/json" }
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.message || "Submission failed");
        weddingForm.reset();
        setWeddingStatus(document.documentElement.lang === "hu" ? "Köszönjük, hamarosan jelentkezünk az elérhetőséggel." : "Thank you, we’ll be in touch soon about availability.");
      } catch {
        setWeddingStatus(document.documentElement.lang === "hu" ? "A küldés nem sikerült. Kérjük, írj nekünk e-mailt." : "We couldn’t send your enquiry. Please email us instead.", true);
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  }
</script>
