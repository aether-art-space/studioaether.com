---
import { faqItemsFor, introFor, site, localizedNav } from "../lib/site.mjs";
import { homeContent, studioContent, studioImages, studioGalleryImages, studioBackdropImages, selfieContent, selfieImages, equipmentContent, equipmentImages, propsContent, propsImages, homeImages } from "../data/content.mjs";
import BookingFooter from "./BookingFooter.astro";

const { page } = Astro.props;
const hu = page.language === "hu";
const home = homeContent[hu ? "hu" : "en"];
const studio = studioContent[hu ? "hu" : "en"];
const selfie = selfieContent[hu ? "hu" : "en"];
const isEquipment = page.path === "/equipment" || page.path === "/hu/equipment";
const isProps = page.path === "/props" || page.path === "/hu/props";
const collectionPage = isEquipment ? equipmentContent[hu ? "hu" : "en"] : isProps ? propsContent[hu ? "hu" : "en"] : null;
const collectionImages = isEquipment ? equipmentImages : propsImages;
const collectionImageMap = collectionImages as Record<string, Array<{ src: string; alt: string; width?: number; height?: number }>>;
const collectionSections = collectionPage?.sections.map((section) => ({
  heading: section.heading,
  subheading: "subheading" in section ? section.subheading : "",
  paragraphs: section.paragraphs,
  galleries: section.galleries.map((gallery) => ({ imageKey: gallery.imageKey, note: ("note" in gallery ? gallery.note : null) as string[] | null }))
})) ?? [];
const serviceLinks = localizedNav(page.language).flatMap((group) => group.links)
  .filter(([path]) => path !== page.path)
  .slice(0, 4);
const relatedHref = hu ? "/hu/packages" : "/packages";
---

{page.section === "home" ? (
  <>
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__image-wrap">
        <img class="home-hero__image" src={homeImages.hero.src} alt={homeImages.hero.alt} width={homeImages.hero.width} height={homeImages.hero.height} fetchpriority="high" decoding="async" />
        <img class="home-hero__icon" src={homeImages.icon.src} alt={homeImages.icon.alt} width="450" height="436" decoding="async" />
        <div class="home-hero__copy">
          <h1 id="home-title">{page.h1}</h1>
          <a class="button button--inverted" data-gtag-event="booking_click" data-gtag-location="home" href={site.bookingUrl}><span class="home-hero__cta-desktop">{hu ? "foglalás" : "book the studio"}</span><span class="home-hero__cta-mobile">{hu ? "foglalás" : "book the photostudio"}</span></a>
        </div>
      </div>
    </section>
    <section class="home-favourite" aria-labelledby="favourite-title">
      <div class="home-favourite__intro">
        <h2 id="favourite-title">{hu ? <>az új kedvenc<br class="home-mobile-break" />fotóstúdiód</> : <>your new favourite<br class="home-mobile-break" />photostudio</>}</h2>
        <p>{home.introHeading}</p>
      </div>
      <div class="home-feature-grid">
        {home.features.map(([title, copy, href, label], index) => <article class="home-feature">
          <h3>{title}</h3>
          <img src={homeImages.features[index]?.src} alt={homeImages.features[index]?.alt} width="181" height="181" loading="lazy" decoding="async" />
          <p>{copy}</p>
          <a class="text-link" href={href}>{label}</a>
        </article>)}
      </div>
    </section>
    <section class="studio-showcase" aria-labelledby="studio-showcase-title">
      <div class="studio-showcase__copy">
        <h2 id="studio-showcase-title">{home.studioShowcaseTitle}</h2>
        <p>{home.studioShowcaseIntro}</p>
        <p>{home.studioShowcaseBody}</p>
        <a class="button button--secondary studio-showcase__more" href={hu ? "/hu/studio" : "/studio"}>{home.studioShowcaseCta}</a>
      </div>
      <div class="studio-showcase__visuals">
        <div class="studio-showcase__gallery" aria-label={hu ? "Képgaléria a stúdióról" : "Photo gallery of the studio"}>
          {homeImages.creatingArt.map((image, index) => <button class="studio-showcase__gallery-item" type="button" data-gallery-image data-gallery-index={index} data-gallery-src={image.src} data-gallery-alt={image.alt} aria-label={hu ? `Kép megnyitása: ${index + 1}` : `Open image ${index + 1}`}>
            <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
          </button>)}
        </div>
        <aside class="studio-showcase__rent">
          <h3>{hu ? "Stúdióbérlés" : "Studio Rent"}</h3>
          <p>{hu ? <>7.000 HUF<br />/ órától</> : <>starting from<br />7.000. HUF / hour</>}</p>
          <a class="button button--dark studio-showcase__book" data-gtag-event="booking_click" data-gtag-location="home-studio-showcase" href={site.bookingUrl}>{hu ? "foglald le a stúdiót" : "book the photostudio"}</a>
        </aside>
      </div>
    </section>
    <dialog class="studio-lightbox" aria-label={hu ? "Stúdió képgaléria" : "Studio photo gallery"} data-studio-lightbox>
      <button class="studio-lightbox__close" type="button" aria-label={hu ? "Galéria bezárása" : "Close gallery"} data-lightbox-close>×</button>
      <button class="studio-lightbox__previous" type="button" aria-label={hu ? "Előző kép" : "Previous image"} data-lightbox-previous>←</button>
      <img data-lightbox-image src={homeImages.creatingArt[0].src} alt={homeImages.creatingArt[0].alt} width={homeImages.creatingArt[0].width} height={homeImages.creatingArt[0].height} />
      <button class="studio-lightbox__next" type="button" aria-label={hu ? "Következő kép" : "Next image"} data-lightbox-next>→</button>
    </dialog>
    <section class="beginner-section" aria-labelledby="beginner-title">
      <div class="beginner-section__main">
        <h2 id="beginner-title">{home.beginnerHeading}</h2>
        <p class="beginner-section__lead">{home.beginnerLead}</p>
        <div class="beginner-section__proof">{home.beginnerProof.map((paragraph, index) => <p>{index === 1 ? <strong>{paragraph}</strong> : paragraph}</p>)}</div>
        <ul class="beginner-section__steps">{home.beginnerSteps.map((step) => <li>{step}</li>)}</ul>
        <p class="beginner-section__cta"><strong>{home.beginnerCtaLead}</strong>{home.beginnerCtaTail}</p>
      </div>
      <div class="beginner-section__testimonials">
        <blockquote><p>{home.beginnerQuote}</p><footer>{home.beginnerAttribution}</footer></blockquote>
        <blockquote><p>{home.beginnerQuoteSecond}</p><footer>{home.beginnerAttributionSecond}</footer></blockquote>
      </div>
    </section>
    <section class="home-artists" aria-labelledby="artists-title">
      <div class="home-artists__intro">
        <h2 id="artists-title">{home.artistsHeading}</h2>
        <p>{home.artistsLead}</p>
      </div>
      <div class="home-artists__grid">{home.artists.map(([title, copy, href, label], index) => <article class="home-artist-card">
        <h3>{title}</h3>
        <img src={homeImages.artists[index].src} alt={hu ? homeImages.artists[index].altHu : homeImages.artists[index].alt} width={homeImages.artists[index].width} height={homeImages.artists[index].height} loading="lazy" decoding="async" />
        <p>{copy}</p>
        <a class="text-link" href={href}>{label}</a>
      </article>)}</div>
    </section>
    <section class="home-services" aria-labelledby="services-title">
      <div class="home-services__intro">
        <h2 id="services-title">{home.photographersHeading}</h2>
        <p>{home.photographersCopy}</p>
      </div>
      <div class="home-services__grid">{home.photographyServices.map(([title, href, label], index) => <article class="home-service-card">
        <h3>{title}</h3>
        <img src={homeImages.photographers[index].src} alt={homeImages.photographers[index].alt} width={homeImages.photographers[index].width} height={homeImages.photographers[index].height} loading="lazy" decoding="async" />
        <a class="text-link" href={href}>{label}</a>
      </article>)}</div>
      {hu ? <p class="home-services__packages">{home.packagesCopy}</p> : <a class="home-services__packages" href="/photographers-budapest">{home.packagesCopy}</a>}
    </section>
  </>
) : page.path === "/studio" || page.path === "/hu/studio" ? (
  <>
    <section class="studio-intro" aria-labelledby="studio-title">
      <div class="studio-intro__inner">
        <h1 id="studio-title">{page.h1}</h1>
        <p class="studio-intro__eyebrow">{studio.eyebrow}</p>
        <div class="studio-intro__copy">
          <p>{studio.paragraphs[0]}</p>
          <p>{studio.paragraphs[1]}</p>
        </div>
      </div>
    </section>
    <section class="studio-overview" aria-labelledby="studio-facts-title">
      <div class="studio-overview__floorplan"><img src={studioImages[0].src} alt={hu ? "fotóstúdió alaprajz" : studioImages[0].alt} width={studioImages[0].width} height={studioImages[0].height} loading="lazy" decoding="async" /></div>
      <div class="studio-overview__facts">
        <h2 id="studio-facts-title">{studio.heading}</h2>
        <ul>{studio.facts.map((fact) => <li>{fact}</li>)}</ul>
      </div>
    </section>
    <section class="studio-gallery" aria-label={hu ? "Képgaléria a stúdióról" : "Photo gallery of the studio"}>
      <div class="studio-gallery__track">
        <div class="studio-gallery__column studio-gallery__column--wide">
          {[0, 1, 2].map((index) => <button class={`studio-gallery__item studio-gallery__item--${studioGalleryImages[index].layout}`} type="button" data-gallery-image data-gallery-index={index} data-gallery-src={studioGalleryImages[index].src} data-gallery-alt={studioGalleryImages[index].alt} aria-label={hu ? `Kép megnyitása: ${index + 1}` : `Open image ${index + 1}`}><img src={studioGalleryImages[index].src} alt={studioGalleryImages[index].alt} width={studioGalleryImages[index].width} height={studioGalleryImages[index].height} loading="eager" decoding="async" /></button>)}
        </div>
        <div class="studio-gallery__column studio-gallery__column--medium">
          {[3, 4].map((index) => <button class={`studio-gallery__item studio-gallery__item--${studioGalleryImages[index].layout}`} type="button" data-gallery-image data-gallery-index={index} data-gallery-src={studioGalleryImages[index].src} data-gallery-alt={studioGalleryImages[index].alt} aria-label={hu ? `Kép megnyitása: ${index + 1}` : `Open image ${index + 1}`}><img src={studioGalleryImages[index].src} alt={studioGalleryImages[index].alt} width={studioGalleryImages[index].width} height={studioGalleryImages[index].height} loading="eager" decoding="async" /></button>)}
        </div>
        <div class="studio-gallery__column studio-gallery__column--narrow">
          {[5, 6].map((index) => <button class={`studio-gallery__item studio-gallery__item--${studioGalleryImages[index].layout}`} type="button" data-gallery-image data-gallery-index={index} data-gallery-src={studioGalleryImages[index].src} data-gallery-alt={studioGalleryImages[index].alt} aria-label={hu ? `Kép megnyitása: ${index + 1}` : `Open image ${index + 1}`}><img src={studioGalleryImages[index].src} alt={studioGalleryImages[index].alt} width={studioGalleryImages[index].width} height={studioGalleryImages[index].height} loading="eager" decoding="async" /></button>)}
        </div>
        {studioGalleryImages.slice(7, 19).map((image, offset) => { const index = offset + 7; return <div class="studio-gallery__column studio-gallery__column--portrait"><button class="studio-gallery__item studio-gallery__item--portrait" type="button" data-gallery-image data-gallery-index={index} data-gallery-src={image.src} data-gallery-alt={image.alt} aria-label={hu ? `Kép megnyitása: ${index + 1}` : `Open image ${index + 1}`}><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="eager" decoding="async" /></button></div>; })}
        <div class="studio-gallery__column studio-gallery__column--final">
          {[19, 20, 21].map((index) => <button class={`studio-gallery__item studio-gallery__item--${studioGalleryImages[index].layout}`} type="button" data-gallery-image data-gallery-index={index} data-gallery-src={studioGalleryImages[index].src} data-gallery-alt={studioGalleryImages[index].alt} aria-label={hu ? `Kép megnyitása: ${index + 1}` : `Open image ${index + 1}`}><img src={studioGalleryImages[index].src} alt={studioGalleryImages[index].alt} width={studioGalleryImages[index].width} height={studioGalleryImages[index].height} loading="eager" decoding="async" /></button>)}
        </div>
        <div class="studio-gallery__column studio-gallery__column--extra"><button class="studio-gallery__item studio-gallery__item--extra-wide" type="button" data-gallery-image data-gallery-index="22" data-gallery-src={studioGalleryImages[22].src} data-gallery-alt={studioGalleryImages[22].alt} aria-label={hu ? "Kép megnyitása: 23" : "Open image 23"}><img src={studioGalleryImages[22].src} alt={studioGalleryImages[22].alt} width={studioGalleryImages[22].width} height={studioGalleryImages[22].height} loading="eager" decoding="async" /></button></div>
      </div>
    </section>
    <section class="studio-backdrops" aria-labelledby="backdrops-title">
      <div class="studio-backdrops__intro">
        <h2 id="backdrops-title">{studio.backdropHeading}</h2>
        <span class="studio-backdrops__rule" aria-hidden="true"></span>
        <p>{studio.backdropCopy}</p>
        <p><strong>{studio.backdropCta}</strong></p>
      </div>
      <div class="studio-backdrops__grid">
        {studioBackdropImages.map((backdrop, index) => <figure><img src={backdrop.src} alt={hu ? `${studio.backdropList[index]} háttér` : backdrop.alt} width="152" height="152" loading="lazy" decoding="async" /><figcaption>{studio.backdropList[index]}</figcaption></figure>)}
      </div>
      <p class="studio-backdrops__note">{studio.backdropNote}</p>
    </section>
    <BookingFooter page={page} />
    <dialog class="studio-lightbox studio-lightbox--page" aria-label={hu ? "Stúdió képgaléria" : "Studio photo gallery"} data-studio-lightbox>
      <button class="studio-lightbox__close" type="button" aria-label={hu ? "Galéria bezárása" : "Close gallery"} data-lightbox-close>×</button>
      <button class="studio-lightbox__previous" type="button" aria-label={hu ? "Előző kép" : "Previous image"} data-lightbox-previous>←</button>
      <img data-lightbox-image src={studioGalleryImages[0].src} alt={studioGalleryImages[0].alt} />
      <button class="studio-lightbox__next" type="button" aria-label={hu ? "Következő kép" : "Next image"} data-lightbox-next>→</button>
    </dialog>
  </>
) : page.path === "/selfie-studio-budapest" || page.path === "/hu/selfie-studio-budapest" ? (
  <>
    <section class="selfie-hero" aria-labelledby="selfie-title">
      <img class="selfie-hero__image" src={selfieImages.hero.src} alt={selfieImages.hero.alt} width={selfieImages.hero.width} height={selfieImages.hero.height} fetchpriority="high" decoding="async" />
      <div class="selfie-hero__veil" aria-hidden="true"></div>
      <div class="selfie-hero__content">
        <h1 id="selfie-title">{selfie.heroHeading.split("\n").map((line) => <span>{line}</span>)}</h1>
        <h2>{selfie.heroSubheading}</h2>
        <p>{selfie.heroCopy}</p>
        <a class="button button--dark" data-gtag-event="selfie_booking_click" data-gtag-location="selfie-studio-hero" href={site.selfieBookingUrl} target="_blank" rel="noreferrer noopener">{selfie.heroCta}</a>
      </div>
    </section>
    <section class="selfie-process" aria-labelledby="selfie-process-title">
      <h2 id="selfie-process-title">{selfie.processHeading}</h2>
      <ol class="selfie-process__list">
        {selfie.processSteps.map((step) => { const note = step.length === 3 ? step[1] : ""; return <li><span>{step[0]}</span>{note && <small>{note}</small>}</li>; })}
      </ol>
      <div class="selfie-process__images">
        {selfieImages.process.map((image) => <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />)}
      </div>
    </section>
    <section class="selfie-gallery" aria-labelledby="selfie-gallery-title">
      <h2 id="selfie-gallery-title">{selfie.galleryHeading}</h2>
      <div class="selfie-gallery__track">{selfieImages.gallery.map((image) => <figure><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /></figure>)}</div>
    </section>
    <section class="selfie-customize" aria-labelledby="selfie-customize-title">
      <div class="selfie-customize__intro">
        <h2 id="selfie-customize-title">{selfie.customizeHeading}</h2>
        <p>{selfie.customizeCopy}</p>
      </div>
      <div class="selfie-controls">
        {selfie.controls.map((control) => { const label = control[0] as string; const options = control[1] as string[]; const ids = control[2] as string[]; return <article class="selfie-control"><h3>{label}</h3><div class="selfie-control__images">{ids.map((id, index) => { const image = selfieImages.controls.get(id); return image && <figure><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /><figcaption>{options[index]}</figcaption></figure>; })}</div><p class="selfie-control__options">{options.join(", ")}</p></article>; })}
      </div>
      <p class="selfie-customize__custom">{selfie.customizeCustom}</p>
    </section>
    <section class="selfie-benefits" aria-labelledby="selfie-benefits-title">
      <div class="selfie-benefits__intro"><h2 id="selfie-benefits-title">{selfie.benefitsHeading}</h2><p>{selfie.benefitsIntro}</p></div>
      <div class="selfie-benefits__grid">{selfie.benefits.map(([title, copy], index) => { const image = selfieImages.benefits[index]; return <article class="selfie-benefit"><h3>{title}</h3><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /><p>{copy}</p></article>; })}</div>
    </section>
    <section class="selfie-prices" aria-labelledby="selfie-prices-title">
      <div class="selfie-prices__intro"><h2 id="selfie-prices-title">{selfie.pricesHeading}</h2></div>
      <div class="selfie-prices__grid">{selfie.prices.map((priceItem, index) => { const title = priceItem[0] as string; const details = priceItem[1] as string[]; const price = priceItem[2] as string; const image = selfieImages.prices[index]; return <article class="selfie-price"><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /><div class="selfie-price__copy"><h3>{title}</h3>{details.map((detail) => <p>{detail}</p>)}<strong>{price}</strong></div></article>; })}</div>
      <div class="selfie-extras"><h3>{selfie.extrasHeading}</h3>{selfie.extras.map(([title, price, note]) => <p><strong>{title}</strong><span>{price}</span>{note && <small>{note}</small>}</p>)}</div>
      <div class="selfie-reserve"><h3>{selfie.reserveHeading}</h3><p>{selfie.reserveCopy}</p><a class="button button--dark" data-gtag-event="selfie_booking_click" data-gtag-location="selfie-studio-reserve" href={site.selfieBookingUrl} target="_blank" rel="noreferrer noopener">{selfie.reserveCta}</a></div>
    </section>
    <section class="selfie-location" aria-labelledby="selfie-location-title">
      <div><h2 id="selfie-location-title">{selfie.szegedHeading}</h2><p>{selfie.szegedCopy}</p><a class="text-link" href={hu ? "https://www.aetherstudio-szeged.com/" : "https://www.aetherstudio-szeged.com/en"} target="_blank" rel="noreferrer noopener">{selfie.szegedCta}</a></div>
    </section>
  </>
) : collectionPage ? (
  <>
    <section class="collection-hero" aria-labelledby="collection-title">
      <h1 id="collection-title">{collectionPage.heroHeading}</h1>
      <p>{collectionPage.heroCopy}</p>
    </section>
    {collectionSections.map((section, index) => (
      <section class={`collection-section collection-section--${section.galleries[0].imageKey}`} aria-labelledby={`collection-section-${index}`}>
        <div class="collection-section__intro">
          <h2 id={`collection-section-${index}`}>{section.heading}</h2>
          {section.subheading && <h3>{section.subheading}</h3>}
          <span class="collection-section__rule" aria-hidden="true"></span>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {section.galleries.map((gallery) => <div class="collection-gallery-wrap">
          <div class={`collection-gallery collection-gallery--${gallery.imageKey}`}>
            {collectionImageMap[gallery.imageKey].map((image) => <figure><button class="collection-gallery__item" type="button" data-gallery-image data-gallery-src={image.src} data-gallery-alt={image.alt} aria-label={hu ? "Kép megnyitása" : "Open image"}><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /></button></figure>)}
          </div>
          {gallery.note && <div class="collection-gallery__note"><p>{gallery.note[0]}</p>{gallery.note[1] && <strong>{gallery.note[1]}</strong>}</div>}
        </div>)}
      </section>
    ))}
    <dialog class="studio-lightbox studio-lightbox--page" aria-label={hu ? "Kellék- és felszerelés galéria" : "Props and equipment gallery"} data-studio-lightbox>
      <button class="studio-lightbox__close" type="button" aria-label={hu ? "Galéria bezárása" : "Close gallery"} data-lightbox-close>×</button>
      <button class="studio-lightbox__previous" type="button" aria-label={hu ? "Előző kép" : "Previous image"} data-lightbox-previous>←</button>
      <img data-lightbox-image src={collectionImageMap[collectionSections[0].galleries[0].imageKey][0].src} alt="" />
      <button class="studio-lightbox__next" type="button" aria-label={hu ? "Következő kép" : "Next image"} data-lightbox-next>→</button>
    </dialog>
  </>
) : page.path === "/post-booking" || page.path === "/hu/post-booking" ? (
  <>
    <section class="hero"><p class="eyebrow">{hu ? "foglalás visszaigazolása" : "booking confirmation"}</p><h1>{page.h1}</h1><p class="hero-lead">{hu ? "Hamarosan jelentkezünk a foglalásod részleteivel." : "We will be in touch shortly with the details of your booking."}</p></section>
    <section class="callout"><h2>{hu ? "Köszönjük, hogy az aether art space-t választottad." : "Thank you for choosing aether art space."}</h2><a class="button button--dark" href={hu ? "/hu" : "/"}>{hu ? "vissza a főoldalra" : "back to home"}</a></section>
  </>
) : page.section === "booking" ? (
  <>
    <section class="hero"><p class="eyebrow">{hu ? "foglalás" : "booking"}</p><h1>{page.h1}</h1><p class="hero-lead">{introFor(page)}</p><div class="actions"><a class="button" data-gtag-event="booking_click" data-gtag-location="booking" href={site.bookingUrl}>{hu ? "fotóstúdió foglalása" : "book the photo studio"}</a><a class="button button--outline" data-gtag-event="selfie_booking_click" data-gtag-location="booking" href={site.selfieBookingUrl}>{hu ? "szelfi stúdió foglalása" : "book the selfie studio"}</a></div></section>
    <section class="price-grid"><article><p class="eyebrow">studio rent</p><h2>7.000 HUF / hour</h2><p>{hu ? "A fotóstúdió használata felszereléssel és helyszíni segítséggel." : "Studio rental for your photoshoot, workshop or creative project."}</p></article><article><p class="eyebrow">photoshoots</p><h2>from 39.000 HUF</h2><p>{hu ? "Fotózási csomagok különböző méretű projektekhez." : "Photoshoot packages for projects of different sizes and purposes."}</p></article><article><p class="eyebrow">selfie studio</p><h2>private session</h2><p>{hu ? "Privát fotózás saját tempóban." : "A private, self-directed photo session."}</p></article></section>
