---
type PageHeroVariant = "collection" | "artist" | "packages" | "models" | "service" | "studio";

interface Props {
  title: string;
  lead?: string;
  subtitle?: string;
  headingId: string;
  variant: PageHeroVariant;
  eyebrow?: string;
  description?: string | string[];
  className?: string;
}

const { title, lead, subtitle, headingId, variant, eyebrow, description, className } = Astro.props;
const descriptions = description ? (Array.isArray(description) ? description : [description]) : [];
---

<section class:list={["page-hero", `page-hero--${variant}`, className]} aria-labelledby={headingId} data-reveal-section>
  {eyebrow && <p class="page-hero__eyebrow" data-reveal-item>{eyebrow}</p>}
  <h1 id={headingId} data-reveal-item>{title}</h1>
  {subtitle && <p class="page-hero__subtitle" data-reveal-item>{subtitle}</p>}
  {lead && <p class="page-hero__subtitle page-hero__lead" data-reveal-item>{lead}</p>}
  {descriptions.length > 0 && <div class="page-hero__description" data-reveal-item>{descriptions.map((paragraph) => <p>{paragraph}</p>)}</div>}
  <slot />
</section>
