---
import ResponsiveImage from "./ResponsiveImage.astro";

interface Props {
  heading: string;
  intro: string;
  bullets: string[];
  tail?: string;
  imageSrc?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  emphasizeBulletLeadins?: boolean;
  className?: string;
}

const {
  heading,
  intro,
  bullets,
  tail,
  imageSrc,
  imageAlt = "",
  imageWidth = 5750,
  imageHeight = 3833,
  emphasizeBulletLeadins = false,
  className = ""
} = Astro.props;

const sectionClass = ["studio-section", imageSrc ? "studio-section--split" : "", className].filter(Boolean).join(" ");
---

<section class={sectionClass} data-reveal-section>
  {imageSrc ? <div class="studio-section__copy">
    <h2 data-reveal-item>{heading}</h2>
    <p data-reveal-item>{intro}</p>
    <ul>
      {bullets.map((bullet) => {
        const [title, ...rest] = bullet.split(" – ");
        return <li>{emphasizeBulletLeadins ? <><strong>{title}</strong>{rest.length > 0 ? ` – ${rest.join(" – ")}` : ""}</> : bullet}</li>;
      })}
    </ul>
    {tail && <p data-reveal-item>{tail}</p>}
  </div> : <>
    <h2 data-reveal-item>{heading}</h2>
    <p data-reveal-item>{intro}</p>
    <ul>
      {bullets.map((bullet) => {
        const [title, ...rest] = bullet.split(" – ");
        return <li>{emphasizeBulletLeadins ? <><strong>{title}</strong>{rest.length > 0 ? ` – ${rest.join(" – ")}` : ""}</> : bullet}</li>;
      })}
    </ul>
    {tail && <p data-reveal-item>{tail}</p>}
  </>}
  {imageSrc && <div class="studio-section__image" data-reveal-item><ResponsiveImage image={{ src: imageSrc, alt: imageAlt, width: imageWidth, height: imageHeight }} role="content" loading="lazy" /></div>}
</section>
