---
import ResponsiveImage from "./ResponsiveImage.astro";

type CircularCardVariant = "feature" | "artist" | "service";

interface CardImage {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

interface Props {
  variant: CircularCardVariant;
  title: string;
  image: CardImage;
  copy?: string;
  href?: string;
  linkLabel?: string;
  className?: string;
}

const { variant, title, image, copy, href, linkLabel, className = "" } = Astro.props;
const imageWidth = image.width ?? (variant === "service" ? 150 : 181);
const imageHeight = image.height ?? (variant === "service" ? 149 : 181);
const cardClass = ["circular-card", `circular-card--${variant}`, className].filter(Boolean).join(" ");
---

<article class={cardClass} data-reveal-item>
  {href ? <a class="circular-card__link" href={href}>
    <h3>{title}</h3>
    <ResponsiveImage image={{ ...image, width: imageWidth, height: imageHeight }} role="card" loading="lazy" />
    {copy && <p>{copy}</p>}
    {linkLabel && <span class="text-link">{linkLabel}</span>}
  </a> : <>
    <h3>{title}</h3>
    <ResponsiveImage image={{ ...image, width: imageWidth, height: imageHeight }} role="card" loading="lazy" />
    {copy && <p>{copy}</p>}
  </>}
</article>
