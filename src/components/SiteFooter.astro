---
import { ClockIcon, InfoIcon, MapPinIcon, PhoneIcon } from "@phosphor-icons/react/ssr";
import BookingFooter from "./BookingFooter.astro";
import ResponsiveImage from "./ResponsiveImage.astro";
import { bookingFooterVariantFor, site } from "../lib/site.mjs";
const { page, consentEnabled = false } = Astro.props;
const hu = page.language === "hu";
const de = page.language === "de";
const copy = de ? { details: "Kontakt und Studioinformationen", contact: "Kontakt & Social Media", pages: "Weitere Seiten", privacy: "Datenschutzerklärung", cookies: "Cookie-Einstellungen", hours: "Öffnungszeiten", appointment: "NUR MIT TERMIN", days: "Montag – Sonntag", address: "Adresse", country: "UNGARN – 1093 Budapest", doorbell: "Klingel Nr. 4", instagram: " auf Instagram", facebook: " auf Facebook" } : hu ? { details: "Kapcsolat és stúdióinformációk", contact: "Kapcsolat és közösségi média", pages: "Egyéb oldalak", privacy: "Adatkezelési tájékoztató", cookies: "Süti beállítások", hours: "Nyitvatartás", appointment: "CSAK IDŐPONTTAL", days: "Hétfő - Vasárnap", address: "Cím", country: "MAGYARORSZÁG – 1093 Budapest", doorbell: "4-es kapucsengő", instagram: " Instagramon", facebook: " Facebookon" } : { details: "Contact and studio information", contact: "Contact & Socials", pages: "Other pages", privacy: "Privacy Policy", cookies: "Cookie settings", hours: "Opening hours", appointment: "APPOINTMENT ONLY", days: "Monday - Sunday", address: "Address", country: "HUNGARY – 1093 Budapest", doorbell: "#4 doorbell", instagram: " on Instagram", facebook: " on Facebook" };
const bookingFooterVariant = bookingFooterVariantFor(page);
---
<footer class="site-footer">
  {bookingFooterVariant && <BookingFooter page={page} variant={bookingFooterVariant} />}
  <section class="site-footer__details" aria-label={copy.details}>
    <div class="site-footer__grid">
      <div class="footer-column footer-column--contact">
        <div class="footer-icon-slot" aria-hidden="true"><PhoneIcon className="footer-icon footer-icon--phone" size={23} weight="regular" /></div>
        <h2>{copy.contact}</h2>
        <div class="footer-contact-group">
          <a href="tel:+36703861739">HU / EN:&nbsp;<strong>+36/70-386-17-39</strong></a>
          <a href={`mailto:${site.email}?subject=contact%20from%20website%20footer`}>{site.email}</a>
        </div>
        <div class="footer-contact-group footer-contact-group--social">
          <a href={site.instagramUrl} target="_blank" rel="noreferrer noopener"><strong>@aether.art.space</strong>{copy.instagram}</a>
          <a href={site.facebookUrl} target="_blank" rel="noreferrer noopener"><strong>aetherbudapest</strong>{copy.facebook}</a>
        </div>
      </div>
      <nav class="footer-column footer-column--pages" aria-label={copy.pages}>
        <div class="footer-icon-slot" aria-hidden="true"><InfoIcon className="footer-icon footer-icon--info" size={25} weight="regular" /></div>
        <h2>{copy.pages}</h2>
        <a href={de ? "/de/faq" : hu ? "/hu/faq" : "/faq"}>FAQ</a>
        <a href={de ? "/de/privacy-policy" : hu ? "/hu/privacy-policy" : "/privacy-policy"}>{copy.privacy}</a>
        {consentEnabled && <button class="cookie-settings-link" type="button" data-cookie-settings>{copy.cookies}</button>}
      </nav>
      <div class="footer-column footer-column--brand" aria-hidden="true">
        <ResponsiveImage image={{ src: "/images/wix/jpg/logo-icon.jpg", alt: "", width: 450, height: 436, sizes: "100px" }} role="logo" loading="lazy" />
      </div>
      <div class="footer-column footer-column--hours">
        <div class="footer-icon-slot" aria-hidden="true"><ClockIcon className="footer-icon footer-icon--clock" size={24} weight="regular" /></div>
        <h2>{copy.hours}</h2>
        <p>{copy.appointment}<br /><br />{copy.days}<br />09:00 - 22:00</p>
      </div>
      <div class="footer-column footer-column--address">
        <div class="footer-icon-slot" aria-hidden="true"><MapPinIcon className="footer-icon footer-icon--location" size={29} weight="regular" /></div>
        <h2>{copy.address}</h2>
        <address>
          <span>{copy.country}</span>
          <span><a href={site.mapsUrl} target="_blank" rel="noreferrer noopener">Lónyay utca 60.</a>&nbsp;{copy.doorbell}</span>
        </address>
      </div>
    </div>
  </section>
</footer>
