---
import ResponsiveImage from "./ResponsiveImage.astro";

type ImageHeroVariant = "home" | "selfie" | "christmas";

interface HeroImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface HeroIcon {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  variant: ImageHeroVariant;
  title: string;
  headingId: string;
  image: HeroImage;
  icon?: HeroIcon;
  subheading?: string;
  lead?: string;
}

const { variant, title, headingId, image, icon, subheading, lead } = Astro.props;
const lines = title.split("\n");
---

<section class={`image-hero image-hero--${variant}`} aria-labelledby={headingId}>
  <div class="image-hero__image-wrap">
    <ResponsiveImage image={image} role="hero" className="image-hero__image" loading="eager" fetchpriority="high" />
    <div class="image-hero__veil" aria-hidden="true"></div>
    {icon && <ResponsiveImage image={icon} role="decorative" className="image-hero__icon" loading="eager" />}
    <div class="image-hero__content">
      <h1 id={headingId}>{lines.map((line) => <span>{line}</span>)}</h1>
      {subheading && <h2>{subheading}</h2>}
      {lead && <p>{lead}</p>}
      <slot />
    </div>
  </div>
</section>
