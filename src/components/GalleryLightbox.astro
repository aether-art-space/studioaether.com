---
const { label, hu = false, variant = "page" } = Astro.props;
---
<dialog class={`studio-lightbox${variant === "page" ? " studio-lightbox--page" : ""}`} aria-label={label} data-studio-lightbox>
  <button class="studio-lightbox__close" type="button" aria-label={hu ? "Galéria bezárása" : "Close gallery"} data-lightbox-close>×</button>
  <button class="studio-lightbox__previous" type="button" aria-label={hu ? "Előző kép" : "Previous image"} data-lightbox-previous>
    <svg class="studio-lightbox__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12H4m0 0 6-6m-6 6 6 6" /></svg>
  </button>
  <div class="studio-lightbox__content">
    <figure class="studio-lightbox__figure">
      <div class="studio-lightbox__image-wrap">
        <picture>
          <source data-lightbox-avif type="image/avif" />
          <source data-lightbox-webp type="image/webp" />
          <img data-lightbox-image src="" alt="" decoding="async" />
        </picture>
      </div>
      <figcaption class="studio-lightbox__caption" data-lightbox-caption>
        <div class="studio-lightbox__caption-head">
          <span class="studio-lightbox__counter" data-lightbox-counter aria-live="polite"></span>
          <span class="studio-lightbox__status" data-lightbox-status aria-live="polite"></span>
        </div>
        <h2 class="studio-lightbox__title" id="lightbox-title" data-lightbox-title hidden></h2>
        <p id="lightbox-description" data-lightbox-description hidden></p>
        <p class="studio-lightbox__price" data-lightbox-price hidden></p>
        <a class="studio-lightbox__link" data-lightbox-link target="_blank" rel="noreferrer noopener" hidden></a>
      </figcaption>
    </figure>
  </div>
  <button class="studio-lightbox__next" type="button" aria-label={hu ? "Következő kép" : "Next image"} data-lightbox-next>
    <svg class="studio-lightbox__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h16m0 0-6-6m6 6-6 6" /></svg>
  </button>
</dialog>
