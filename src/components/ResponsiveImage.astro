---
import { resolveImage } from "../lib/images.mjs";

interface Props {
  image: { src?: string; source?: string; alt?: string; width?: number; height?: number; sizes?: string };
  role?: "hero" | "card" | "decorative" | "logo" | "gallery" | "content" | "thumb";
  className?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "sync" | "auto";
  objectPosition?: string;
}

const { image, role = "content", className = "", loading = role === "hero" ? "eager" : "lazy", fetchpriority, decoding = "async", objectPosition } = Astro.props;
const asset = resolveImage(image, role);
const style = objectPosition ? `object-position: ${objectPosition};` : undefined;
---
<picture class="responsive-image">
  {asset.avifSrcset && <source type="image/avif" srcset={asset.avifSrcset} sizes={asset.sizes} />}
  {asset.webpSrcset && <source type="image/webp" srcset={asset.webpSrcset} sizes={asset.sizes} />}
  <img
    class={className}
    src={asset.src}
    srcset={asset.fallbackSrcset || undefined}
    sizes={asset.sizes}
    alt={asset.alt}
    width={asset.width}
    height={asset.height}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding={decoding}
    style={style}
  />
</picture>
