---
interface ExtraItem {
  title: string;
  priceLabel: string;
  price: string;
  href?: string;
  linkLabel?: string;
}

interface Props {
  heading: string;
  items: ExtraItem[];
  intro?: string[];
  headingId?: string;
  showLinks?: boolean;
  className?: string;
}

const {
  heading,
  items,
  intro = [],
  headingId = "extras-section-title",
  showLinks = false,
  className = ""
} = Astro.props;

const sectionClass = ["service-upgrades", "extras-section", className].filter(Boolean).join(" ");
---

<section class={sectionClass} aria-labelledby={headingId}>
  <h3 id={headingId}>{heading}</h3>
  {intro.map((paragraph) => <p>{paragraph}</p>)}
  <div class="service-upgrade-grid">
    {items.map((item) => <article>
      <h4>{item.title}</h4>
      <span>{item.priceLabel}</span>
      <strong>{item.price}</strong>
      {showLinks && item.href && <a class="text-link" href={item.href}>{item.linkLabel ?? "learn more"}</a>}
    </article>)}
  </div>
</section>
