---
const { enabled = false, page } = Astro.props;
const hu = page.language === "hu";
const privacyHref = hu ? "/hu/privacy-policy" : "/privacy-policy";
const titleId = `cookie-consent-title-${hu ? "hu" : "en"}`;
---

{enabled && <div class="cookie-consent" data-cookie-consent hidden>
  <section class="cookie-consent__panel" aria-labelledby={titleId}>
    <div class="cookie-consent__copy">
      <h2 id={titleId}>{hu ? "Süti tájékoztató" : "Cookie notice"}</h2>
      <p>
        {hu
          ? "A szükséges sütik biztosítják a webhely működését. Az opcionális analitikai és hirdetési sütiket csak akkor használjuk, ha engedélyezed őket."
          : "We use necessary cookies to keep the website working. Optional analytics and advertising cookies are used only if you accept them."}
        {" "}<a href={privacyHref}>{hu ? "Adatvédelmi tájékoztató" : "Privacy Policy"}</a>
      </p>
    </div>
    <div class="cookie-consent__actions">
      <button class="button button--secondary" type="button" data-cookie-consent-necessary>
        {hu ? "Csak szükséges" : "Only necessary"}
      </button>
      <button class="button" type="button" data-cookie-consent-all>
        {hu ? "Összes elfogadása" : "Accept all"}
      </button>
    </div>
  </section>
</div>}

{enabled && <script is:inline src="/cookie-consent.js" defer />}
