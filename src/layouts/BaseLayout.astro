---
import Seo from "../components/Seo.astro";
import CookieConsent from "../components/CookieConsent.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../data/routes.mjs";

const { page } = Astro.props;
const preview = import.meta.env.PUBLIC_DEPLOY_ENV === "preview";
const consentEnabled = !preview && Boolean(site.tracking.googleTagId || site.tracking.ga4Id || site.tracking.googleAdsId);
---
<!doctype html>
<html lang={page.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo page={page} />
    <link rel="preload" href="/fonts/Jitter-Regular-hun-v2.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/Jura-400.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="stylesheet" href="/site.css" />
    <link rel="stylesheet" href="/content.css?v=20260907-05" />
  </head>
  <body>
    <a class="skip-link" href="#main">{page.language === "hu" ? "Ugrás a tartalomhoz" : "Skip to content"}</a>
    <SiteHeader page={page} />
    <main id="main"><slot /></main>
    <SiteFooter page={page} consentEnabled={consentEnabled} />
    <CookieConsent page={page} enabled={consentEnabled} />
  </body>
</html>
