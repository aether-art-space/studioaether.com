---
import BaseLayout from "../layouts/BaseLayout.astro";
import KoreanSelfieLayout from "../layouts/KoreanSelfieLayout.astro";
import KoreanSelfieBookingContent from "../components/KoreanSelfieBookingContent.astro";
import PageContent from "../components/PageContent.astro";
import { pages } from "../data/routes.mjs";

export function getStaticPaths() {
  return pages
    .filter((page) => page.path !== "/" && page.disposition !== "redirect")
    .map((page) => ({
      params: { slug: page.path.slice(1) },
      props: { page }
    }));
}

const { page } = Astro.props;
---
{page.language === "ko" ? (
  <KoreanSelfieLayout page={page}>
    {page.path === "/ko/selfie-studio-budapest" ? <PageContent page={page} /> : <KoreanSelfieBookingContent page={page} />}
  </KoreanSelfieLayout>
) : (
  <BaseLayout page={page}><PageContent page={page} /></BaseLayout>
)}
