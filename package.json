{
  "name": "studioaether.com-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:github": "PUBLIC_SITE_URL=https://aether-art-space.github.io PUBLIC_BASE_PATH=/studioaether.com PUBLIC_DEPLOY_ENV=preview ASTRO_TELEMETRY_DISABLED=1 astro build && PUBLIC_BASE_PATH=/studioaether.com node scripts/prepare-github-pages.mjs",
    "gallery:sync": "node scripts/generate-images.mjs",
    "gallery:update": "node scripts/generate-images.mjs",
    "release:build": "node scripts/release-build.mjs",
    "release:publish": "node scripts/publish-pages.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && node scripts/validate.mjs",
    "baseline:visual": "node scripts/capture-visual-baseline.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test:browser": "node scripts/test-browser.mjs",
    "test": "node scripts/test-form-submission.mjs && node scripts/test-korean-selfie-pages.mjs && node scripts/test-korean-selfie-tracking.mjs && node --test scripts/release-artifact.test.mjs scripts/harden-static-build.test.mjs && node scripts/test-health-monitoring.mjs && node --test scripts/restore-image-cache.test.mjs",
    "health:production": "node scripts/health-check.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "astro": "7.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "6.0.3",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@fontsource/baskervville": "5.3.0",
    "@fontsource/jura": "5.3.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "wrangler": "4.157.0"
  }
}
